     RowBox[{"(", 
      RowBox[{
       RowBox[{"expects", " ", "equalities", " ", 
        RowBox[{"var", "[", "0", "]"}]}], "==", "value"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vars", "=", 
