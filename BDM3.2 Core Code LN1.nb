Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "safeLookup", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"safeLookup", "[", 
     RowBox[{"out_", ",", "key_", ",", 
      RowBox[{"default_", ":", 
       RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}]}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"AssociationQ", "[", "out", "]"}], ",", 
      RowBox[{"Lookup", "[", 
       RowBox[{"out", ",", "key", ",", "default"}], "]"}], ",", "default"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"getRunOutDir", ",", "getRunID"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getRunOutDir", "[", "out_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lp", ",", "d"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"AssociationQ", "[", "out", "]"}]}], ",", 
         RowBox[{"Return", "[", "baseDir", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"lp", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"out", ",", "\"\<LogPath\>\"", ",", "None"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", 
           RowBox[{"StringQ", "[", "lp", "]"}]}], "||", 
          RowBox[{"lp", "===", "\"\<\>\""}], "||", 
          RowBox[{"lp", "===", 
           RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}]}], ",", 
         RowBox[{"Return", "[", "baseDir", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"DirectoryName", "@", "lp"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"StringQ", "[", "d", "]"}], "&&", 
          RowBox[{"d", "=!=", "\"\<\>\""}]}], ",", "d", ",", "baseDir"}], 
        "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getRunID", "[", "out_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "id", "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"AssociationQ", "[", "out", "]"}]}], ",", 
        RowBox[{"Return", "[", "\"\<RunID_NotUsed\>\"", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"id", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"out", ",", "\"\<RunID\>\"", ",", 
         RowBox[{"Missing", "[", "\"\<NoRunID\>\"", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"StringQ", "[", "id", "]"}], "&&", 
         RowBox[{"id", "=!=", "\"\<\>\""}]}], ",", "id", 
        ",", "\"\<RunID_NotUsed\>\""}], "]"}]}]}], "]"}]}], 
  ";"}], "\n"}], "Input",
