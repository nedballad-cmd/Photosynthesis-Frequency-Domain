Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"V", ".5", " ", "Construct", " ", "noise"}], "-", 
    RowBox[{"free", " ", "references"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"referenceResults", "=", 
     RowBox[{"Association", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Tval", "->", 
         RowBox[{"Association", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"npp", "->", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"data", ",", "cY", ",", "cU", ",", "G"}], "}"}], ",", 
               RowBox[{
                RowBox[{"data", "=", 
                 RowBox[{"periodicResample", "[", 
                  RowBox[{
                   RowBox[{"referenceData", "[", "Tval", "]"}], ",", 
                   RowBox[{"nObservedPeriods", " ", "npp"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"data", "===", "$Failed"}], ",", "$Failed", ",", 
                  RowBox[{
                   RowBox[{"cY", "=", 
                    RowBox[{"fundamentalC1", "[", 
                    RowBox[{
                    RowBox[{"data", "[", "\"\<ChlF\>\"", "]"}], ",", 
                    "nObservedPeriods"}], "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"cU", "=", 
                    RowBox[{"fundamentalC1", "[", 
                    RowBox[{
                    RowBox[{"data", "[", "\"\<Light\>\"", "]"}], ",", 
                    "nObservedPeriods"}], "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"G", "=", 
                    RowBox[{"cY", "/", "cU"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<Data\>\"", "->", "data"}], ",", 
                    RowBox[{"\"\<C1Y\>\"", "->", "cY"}], ",", 
                    RowBox[{"\"\<C1U\>\"", "->", "cU"}], ",", 
                    RowBox[{"\"\<AmplitudeY\>\"", "->", 
                    RowBox[{"2", " ", 
                    RowBox[{"Abs", "[", "cY", "]"}]}]}], ",", 
                    RowBox[{"\"\<Gain\>\"", "->", 
                    RowBox[{"Abs", "[", "G", "]"}]}], ",", 
                    RowBox[{"\"\<PhaseDeg\>\"", "->", 
                    RowBox[{
                    RowBox[{"Arg", "[", "G", "]"}], "/", "Degree"}]}]}], 
                    "|>"}]}]}], "]"}]}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"npp", ",", "samplesPerPeriod"}], "}"}]}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"Tval", ",", "Tlist"}], "}"}]}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"referenceValidQ", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"r", "=", 
             RowBox[{
              RowBox[{"referenceResults", "[", "Tval", "]"}], "[", "npp", 
              "]"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{"AssociationQ", "[", "r", "]"}], "&&", 
            RowBox[{"NumericQ", "[", 
             RowBox[{"r", "[", "\"\<Gain\>\"", "]"}], "]"}], "&&", 
            RowBox[{"NumericQ", "[", 
             RowBox[{"r", "[", "\"\<PhaseDeg\>\"", "]"}], "]"}], "&&", 
            RowBox[{"NumericQ", "[", 
             RowBox[{"r", "[", "\"\<AmplitudeY\>\"", "]"}], "]"}]}]}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"Tval", ",", "Tlist"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"npp", ",", "samplesPerPeriod"}], "}"}]}], "]"}], "]"}]}]}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<All reference results valid: \>\"", ",", 
      "referenceValidQ"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "V", ".6", " ", "Monte", " ", "Carlo", " ", "noise", " ", "experiment", " ",
       "Noise", " ", "SD", " ", "is", " ", "defined", " ", "relative", " ", 
      "to", " ", "the", " ", "noise"}], "-", 
     RowBox[{"free", " ", "fundamental", " ", "fluorescence", " ", 
      RowBox[{"amplitude", ".", "Noise"}], " ", "is", " ", "independent", " ",
       "Gaussian", " ", "noise", " ", "added", " ", "to", " ", "each", " ", 
      "sampled", " ", "fluorescence", " ", 
      RowBox[{"observation", ".", "Illumination"}], " ", "is", " ", "assumed",
       " ", "known", " ", "without", " ", 
      RowBox[{"noise", "."}]}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "noiseSeed", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"robustnessResults", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "ref", ",", "y", ",", "cU", ",", "amp", ",", "sigma", ",", 
             "noisyY", ",", "cY", ",", "G", ",", "gainError", ",", 
             "phaseError"}], "}"}], ",", 
           RowBox[{
            RowBox[{"ref", "=", 
             RowBox[{
              RowBox[{"referenceResults", "[", "Tval", "]"}], "[", "npp", 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"y", "=", 
             RowBox[{
              RowBox[{"ref", "[", "\"\<Data\>\"", "]"}], "[", "\"\<ChlF\>\"", 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"cU", "=", 
             RowBox[{"ref", "[", "\"\<C1U\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"amp", "=", 
             RowBox[{"ref", "[", "\"\<AmplitudeY\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"sigma", "=", 
             RowBox[{"level", " ", "amp"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"noisyY", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"sigma", "==", "0"}], ",", "y", ",", 
               RowBox[{"y", "+", 
                RowBox[{"RandomVariate", "[", 
                 RowBox[{
                  RowBox[{"NormalDistribution", "[", 
                   RowBox[{"0", ",", "sigma"}], "]"}], ",", 
                  RowBox[{"Length", "[", "y", "]"}]}], "]"}]}]}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"cY", "=", 
             RowBox[{"fundamentalC1", "[", 
              RowBox[{"noisyY", ",", "nObservedPeriods"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"G", "=", 
             RowBox[{"cY", "/", "cU"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"gainError", "=", 
             RowBox[{"100.", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", "G", "]"}], "/", 
                 RowBox[{"ref", "[", "\"\<Gain\>\"", "]"}]}], "-", "1."}], 
               ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"phaseError", "=", 
             RowBox[{"wrapPhaseDegrees", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Arg", "[", "G", "]"}], "/", "Degree"}], "-", 
               RowBox[{"ref", "[", "\"\<PhaseDeg\>\"", "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<T\>\"", "->", "Tval"}], ",", 
              RowBox[{"\"\<SamplesPerPeriod\>\"", "->", "npp"}], ",", 
              RowBox[{"\"\<NoiseRatio\>\"", "->", "level"}], ",", 
              RowBox[{"\"\<Realization\>\"", "->", "r"}], ",", 
              RowBox[{"\"\<NoiseSD\>\"", "->", "sigma"}], ",", 
              RowBox[{"\"\<Gain\>\"", "->", 
               RowBox[{"Abs", "[", "G", "]"}]}], ",", 
              RowBox[{"\"\<PhaseDeg\>\"", "->", 
               RowBox[{
                RowBox[{"Arg", "[", "G", "]"}], "/", "Degree"}]}], ",", 
              RowBox[{"\"\<GainErrorPercent\>\"", "->", "gainError"}], ",", 
              RowBox[{"\"\<PhaseErrorDeg\>\"", "->", "phaseError"}]}], 
             "|>"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"Tval", ",", "Tlist"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"npp", ",", "samplesPerPeriod"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"level", ",", "noiseLevels"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "1", ",", "nRealizations"}], "}"}]}], "]"}], ",", 
       "3"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
