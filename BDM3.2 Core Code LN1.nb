               RowBox[{"PQf", "[", "#", "]"}], ",", 
               RowBox[{"Lfun", "[", "#", "]"}]}], "]"}], ",", 
             "Indeterminate"}], "]"}], "&"}], ")"}]}], ",", 
        RowBox[{"\"\<NPQ\>\"", "->", 
