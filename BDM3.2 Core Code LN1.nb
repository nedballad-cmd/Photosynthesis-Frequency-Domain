               "\[IndentingNewLine]", 
               RowBox[{"rows", "=", 
                RowBox[{"Rest", "[", "tab", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{"expect", " ", 
                  RowBox[{"columns", ":", "Signal"}]}], ",", "k", ",", "f", ",",
                  "ampYk", ",", "ampY1", ",", "Dk"}], "*)"}], 
               RowBox[{"rows", "=", 
                RowBox[{"Select", "[", 
                 RowBox[{"rows", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Length", "[", "#", "]"}], ">=", "6"}], "&"}]}], 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"rows", "=", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"ToString", "@", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", 
