          RowBox[{"#", ">", "0"}]}], "&"}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
      "Print", "[", "\"\<USER KNOB error: Tlist must be a list of positive \
numeric periods.\>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
