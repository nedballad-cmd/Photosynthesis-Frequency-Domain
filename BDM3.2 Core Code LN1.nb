Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Harmonic", " ", "light", " ", "forcing", " ", "dependent", " ", "on", " ",
     "time", " ", "t", " ", "and", " ", "amplitude", " ", "T"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "Light", "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Light", "[", 
       RowBox[{
        RowBox[{"t_", "?", "NumericQ"}], ",", 
        RowBox[{"T_", "?", "NumericQ"}]}], "]"}], "/;", 
      RowBox[{
       RowBox[{"NumericQ", "[", "constL", "]"}], "&&", 
       RowBox[{"NumericQ", "[", "amplL", "]"}]}]}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"constL", "+", 
      RowBox[{"amplL", "*", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "Pi", " ", 
         RowBox[{"t", "/", "T"}]}], "]"}]}]}]}], ";"}], " ", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Smooth", " ", 
       RowBox[{"square", ":", 
        RowBox[{"fundamental", " ", "period", " ", "T"}]}]}], ",", 
      RowBox[{"mean", " ", "constL"}], ",", 
      RowBox[{"amplitude", " ", "amplL"}]}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Light", "[", 
        RowBox[{
         RowBox[{"t_", "?", "NumericQ"}], ",", 
         RowBox[{"T_", "?", "NumericQ"}], ",", 
         RowBox[{"beta_", ":", "20"}]}], "]"}], "/;", 
       RowBox[{
        RowBox[{"NumericQ", "[", "constL", "]"}], "&&", 
        RowBox[{"NumericQ", "[", "amplL", "]"}]}]}], ":=", 
      RowBox[{"constL", "+", 
       RowBox[{"0.637", "*", "amplL", "*", 
        RowBox[{"Tanh", "[", 
         RowBox[{"beta", "*", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"t", "/", "T"}]}], "]"}]}], "]"}]}]}]}], ";"}], " ", 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
