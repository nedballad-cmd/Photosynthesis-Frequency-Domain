 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"And", "[", 
       RowBox[{
        RowBox[{"IntegerQ", "[", "constL", "]"}], ",", 
        RowBox[{"IntegerQ", "[", "amplL", "]"}], ",", 
        RowBox[{"constL", ">=", "0"}], ",", 
        RowBox[{"amplL", ">=", "0"}], ",", 
        RowBox[{"constL", ">=", "amplL"}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
      "Print", "[", "\"\<USER KNOB error: constL and amplL must be \
nonnegative integers with constL \[GreaterEqual] amplL.\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], "\n"}], "\n", 
