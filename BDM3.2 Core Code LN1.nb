      RowBox[{
      "PQ", ",", "PIox", ",", "Zea", ",", "PsbS", ",", "HL", ",", "ATP"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"initStateRules", "=", "\[IndentingNewLine]", 
