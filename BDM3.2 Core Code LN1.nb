 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"findNoiseReference", "[", "Tval_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tag", ",", "matches", ",", "selected"}], "}"}], ",", 
      RowBox[{
       RowBox[{"tag", "=", 
        RowBox[{"\"\<NoiseReference_\>\"", "<>", 
         RowBox[{"formatTTag", "[", "Tval", "]"}], "<>", "\"\<.wdx\>\""}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"matches", "=", 
        RowBox[{"FileNames", "[", 
         RowBox[{"tag", ",", "baseDir", ",", "Infinity"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"matches", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<ERROR: No reference for T = \>\"", ",", "Tval"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"selected", "=", 
        RowBox[{"First", "@", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"matches", ",", 
           RowBox[{
            RowBox[{"AbsoluteTime", "[", 
             RowBox[{"FileDate", "[", 
              RowBox[{"#", ",", "\"\<Modification\>\""}], "]"}], "]"}], 
            "&"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "matches", "]"}], ">", "1"}], ",", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<T = \>\"", ",", "Tval", ",", "\"\< s: \>\"", ",", 
