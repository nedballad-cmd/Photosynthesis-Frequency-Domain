Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "safeTag", ",", "makeSteadyStateXlsxPath", ",", "makeFigurePdfPath", ",", 
     "makeConvergenceLogDirFile"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"sanitize", " ", "filenames"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"safeTag", "[", "s_String", "]"}], ":=", 
    RowBox[{"StringReplace", "[", 
     RowBox[{"s", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\</\>\"", "->", "\"\<_\>\""}], ",", 
        RowBox[{"\"\<\\\\\>\"", "->", "\"\<_\>\""}], ",", 
        RowBox[{"\"\<:\>\"", "->", "\"\<_\>\""}], ",", 
        RowBox[{"\"\< \>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeSteadyStateXlsxPath", "[", 
     RowBox[{"out_", ",", "baseDir_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Tval", ",", "runID", ",", "dir", ",", "base"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"AssociationQ", "[", "out", "]"}]}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{"<", 
         RowBox[{
          RowBox[{"--", "only"}], " ", "change"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Tval", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"out", ",", "\"\<T\>\"", ",", 
          RowBox[{"Missing", "[", "\"\<NoT\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"NumericQ", "[", "Tval", "]"}]}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"runID", "=", 
        RowBox[{"getRunID", "[", "out", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dir", "=", 
        RowBox[{"runPeriodDir", "[", 
         RowBox[{"baseDir", ",", "runID", ",", "Tval"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"base", "=", "\"\<SteadyState_PeriodicOrbit.xlsx\>\""}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"uniqueFile", "@", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dir", ",", "base"}], "}"}], "]"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"PDF", " ", "export", " ", 
    RowBox[{"path", ":", 
     RowBox[{"per", "-", 
      RowBox[{"run", "/", "per"}], "-", 
      RowBox[{"period", " ", "folder"}]}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeFigurePdfPath", "[", 
     RowBox[{"baseDir_String", ",", "runID_String", ",", 
      RowBox[{"T_", "?", "NumericQ"}], ",", "tag_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dir", ",", "base"}], "}"}], ",", 
      RowBox[{
       RowBox[{"dir", "=", 
        RowBox[{"runPeriodDir", "[", 
         RowBox[{"baseDir", ",", "runID", ",", "T"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"base", "=", 
        RowBox[{
         RowBox[{"safeTag", "[", "tag", "]"}], "<>", "\"\<.pdf\>\""}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"uniqueFile", "@", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dir", ",", "base"}], "}"}], "]"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Convergence", " ", "log", " ", "directory"}], "+", 
    RowBox[{"filename", " ", 
     RowBox[{"(", 
      RowBox[{"or", " ", "None", " ", "if", " ", "disabled"}], ")"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeConvergenceLogDirFile", "[", 
    RowBox[{"baseDir_String", ",", "runID_String", ",", 
     RowBox[{"T_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dir", ",", "file"}], "}"}], ",", 
     RowBox[{
      RowBox[{"dir", "=", 
       RowBox[{"runPeriodDir", "[", 
        RowBox[{"baseDir", ",", "runID", ",", "T"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"file", "=", "\"\<ConvergenceLog.csv\>\""}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"or", ".", "txt"}], "/", " ", 
        RowBox[{".", "json"}]}], "*)"}], 
      RowBox[{"{", 
       RowBox[{"dir", ",", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dir", ",", "file"}], "}"}], "]"}]}], "}"}]}]}], "]"}]}], 
