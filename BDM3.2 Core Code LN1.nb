       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{
          RowBox[{"v_", "[", "0", "]"}], "==", "val_"}], "]"}], ":>", 
        RowBox[{"(", 
         RowBox[{"v", "->", 
          RowBox[{"N", "@", "val"}]}], ")"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"initStateSheet", "=", "\[IndentingNewLine]", 
