              RowBox[{"HL", "[", "t", "]"}], ",", 
              RowBox[{"ATP", "[", "t", "]"}], ",", 
              RowBox[{"L", "[", "t", "]"}]}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"HL", "'"}], "[", "t", "]"}], "==", 
            RowBox[{"HLRate", "[", 
             RowBox[{
              RowBox[{"PQ", "[", "t", "]"}], ",", 
              RowBox[{"PIox", "[", "t", "]"}], ",", 
              RowBox[{"Zea", "[", "t", "]"}], ",", 
              RowBox[{"PsbS", "[", "t", "]"}], ",", 
              RowBox[{"HL", "[", "t", "]"}], ",", 
              RowBox[{"ATP", "[", "t", "]"}], ",", 
              RowBox[{"L", "[", "t", "]"}]}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"ATP", "'"}], "[", "t", "]"}], "==", 
            RowBox[{"ATPRate", "[", 
             RowBox[{
              RowBox[{"PQ", "[", "t", "]"}], ",", 
              RowBox[{"PIox", "[", "t", "]"}], ",", 
              RowBox[{"Zea", "[", "t", "]"}], ",", 
