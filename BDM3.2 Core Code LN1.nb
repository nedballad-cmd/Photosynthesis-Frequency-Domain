 CellChangeTimes->{{3.9316167181482306`*^9, 3.931616725207141*^9}, 
   3.9316172604007163`*^9, {3.931617329225854*^9, 3.931617331570511*^9}, {
   3.931618560961228*^9, 3.931618561886388*^9}, {3.931758655571293*^9, 
   3.9317586654545097`*^9}, {3.9317587010901165`*^9, 3.931758757425419*^9}, {
   3.931759443826582*^9, 3.9317594539576263`*^9}, {3.931765976850231*^9, 
   3.931765981879921*^9}, 3.931766325094534*^9, {3.931771477482258*^9, 
   3.9317715012478504`*^9}, 3.9317718408597984`*^9, 3.9666257266214294`*^9, {
   3.966625762946089*^9, 3.9666257757482033`*^9}, {3.9666269362883205`*^9, 
   3.9666269365353165`*^9}, {3.9772096545071354`*^9, 
   3.9772096711677074`*^9}, {3.977335464650997*^9, 3.977335471076271*^9}, {
   3.97754633709873*^9, 3.977546403612154*^9}, {3.9775468481231575`*^9, 
   3.9775468584734535`*^9}, {3.9775468989944134`*^9, 
   3.9775469230248737`*^9}, {3.977550373798399*^9, 3.977550377315895*^9}, {
   3.977557181056284*^9, 3.977557184740883*^9}, 3.977557447352001*^9},
 FontSize->16,
 FontWeight->Bold,ExpressionUUID->"2a924aa3-fb1c-df47-9d45-4de25e6907d5"],

Cell["\<\
This block defines default option values controlling the numerical \
realization of the period-chunked integration scheme in Mathematica. These \
options govern how NDSolve is called for each forcing period, how numerical \
accuracy and precision are enforced, and how convergence thresholds are \
applied when evaluating stopping criteria.
Standard NDSolve options (such as Method, AccuracyGoal, PrecisionGoal, and \
MaxSteps) are combined with custom convergence parameters that specify \
tolerance levels, comparison windows, and maximum iteration counts. The \
choice of convergence metric (e.g. full state vector or chlorophyll \
fluorescence) is handled through user-selectable options, without altering \
the underlying integration algorithm.
The values defined here serve as fallback defaults and may be overridden at \
call time. By default, diagnostic printing and file-based logging are \
disabled to support clean batch execution and parameter sweeps.\
\>", "Text",
 CellChangeTimes->{
  3.9777483942117634`*^9, {3.9778074836107445`*^9, 
   3.9778074870547733`*^9}},ExpressionUUID->"1f7fbdbb-664c-7b4c-8dd1-\
b334611a8492"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Default", " ", "options", " ", "for", " ", "Poincar\[EAcute]", " ", 
     "convergence", " ", "control", " ", "using", " ", "state"}], "-", 
    RowBox[{"or", " ", "fluorescence"}], "-", 
    RowBox[{"based", " ", "criteria"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "RunByPeriods", "]"}], "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\"\<MaxPeriods\>\"", "->", "100"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<ConvWindow\>\"", "->", "3"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<rtol\>\"", "->", "1*^-4"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<atol\>\"", "->", "1*^-6"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<KeepChunkSols\>\"", "->", "False"}], ",", 
      RowBox[{"Method", "->", 
       RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}], ",", 
      RowBox[{"AccuracyGoal", "->", "10"}], ",", 
      RowBox[{"PrecisionGoal", "->", "10"}], ",", 
      RowBox[{"MaxSteps", "->", "Infinity"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<EndpointEpsFactor\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<PrintEvery\>\"", "->", "10"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<ConvergenceMetric\>\"", "->", "\"\<ChlF\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<LogDir\>\"", "->", "None"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<LogFile\>\"", "->", "None"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<LogEvery\>\"", "->", "10"}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{
