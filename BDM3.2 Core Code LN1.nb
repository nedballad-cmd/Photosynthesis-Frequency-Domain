Cell[CellGroupData[{

Cell["1.3.2 Defining ODEs", "Subsection",
 CellChangeTimes->{{3.9317665569203224`*^9, 3.9317666152479057`*^9}, {
   3.9317668661062584`*^9, 3.9317668702815895`*^9}, 3.9317718408597984`*^9, {
   3.9666215604821815`*^9, 3.966621563619461*^9}, {3.977375505335844*^9, 
   3.9773755126954784`*^9}, {3.977375597358471*^9, 3.9773755979526157`*^9}, {
   3.977743373604162*^9, 3.977743377681385*^9}},
 FontSize->14,ExpressionUUID->"439f3354-b9e5-1c47-b43e-df908cc10eff"],

Cell["\<\
This block converts the previously defined rate functions (PQRate, PIoxRate, \
etc.) into the explicit differential-equation form required by NDSolve. Each \
state variable is represented as a time-dependent function (for example \
PQ[t]), and its time derivative is written using \
Mathematica\[CloseCurlyQuote]s derivative notation PQ\[CloseCurlyQuote][t].
The equations are assembled as a list of equalities of the form
variable\[CloseCurlyQuote][t] == rateFunction[ currentStateValues\[Ellipsis], \
input(t) ]
where the \[OpenCurlyDoubleQuote]current state values\[CloseCurlyDoubleQuote] \
are the six state variables evaluated at the same time t, and the input is \
the instantaneous light intensity.
To support parameter sweeps over the forcing period, the ODE list is \
constructed by the function MakeODEs[T]. Calling MakeODEs[T] returns a \
complete list of six ODEs corresponding to that specific period T, without \
relying on a global variable. This makes each run independent and prevents \
cross-talk when looping (or running in parallel).
Inside MakeODEs, a local helper function L[tt] is defined as L[tt] = \
Light[tt, T]. This provides a one-argument \
\[OpenCurlyDoubleQuote]light-at-time\[CloseCurlyDoubleQuote] function for \
readability in the ODE definitions, while still keeping the dependence on T \
explicit and local to the current run.\
\>", "Text",
 CellChangeTimes->{{3.9778004368093185`*^9, 3.9778004578245106`*^9}, {
  3.977800681006613*^9, 
  3.977800690048256*^9}},ExpressionUUID->"2b705b04-506c-a041-9e80-\
17a26f52d855"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "MakeODEs", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeODEs", "[", 
    RowBox[{"T_", "?", "NumericQ"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"L", ",", "ODEs"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Tnow", "=", "T"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"L", "[", 
          RowBox[{"tt_", "?", "NumericQ"}], "]"}], ":=", 
         RowBox[{"Light", "[", 
          RowBox[{"tt", ",", "Tnow"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"ODEs", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"PQ", "'"}], "[", "t", "]"}], "==", 
            RowBox[{"PQRate", "[", 
             RowBox[{
              RowBox[{"PQ", "[", "t", "]"}], ",", 
              RowBox[{"PIox", "[", "t", "]"}], ",", 
              RowBox[{"Zea", "[", "t", "]"}], ",", 
              RowBox[{"PsbS", "[", "t", "]"}], ",", 
              RowBox[{"HL", "[", "t", "]"}], ",", 
              RowBox[{"ATP", "[", "t", "]"}], ",", 
              RowBox[{"L", "[", "t", "]"}]}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"PIox", "'"}], "[", "t", "]"}], "==", 
            RowBox[{"PIoxRate", "[", 
             RowBox[{
              RowBox[{"PQ", "[", "t", "]"}], ",", 
              RowBox[{"PIox", "[", "t", "]"}], ",", 
              RowBox[{"Zea", "[", "t", "]"}], ",", 
              RowBox[{"PsbS", "[", "t", "]"}], ",", 
              RowBox[{"HL", "[", "t", "]"}], ",", 
              RowBox[{"ATP", "[", "t", "]"}], ",", 
              RowBox[{"L", "[", "t", "]"}]}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Zea", "'"}], "[", "t", "]"}], "==", 
            RowBox[{"ZeaRate", "[", 
             RowBox[{
              RowBox[{"PQ", "[", "t", "]"}], ",", 
              RowBox[{"PIox", "[", "t", "]"}], ",", 
              RowBox[{"Zea", "[", "t", "]"}], ",", 
              RowBox[{"PsbS", "[", "t", "]"}], ",", 
              RowBox[{"HL", "[", "t", "]"}], ",", 
              RowBox[{"ATP", "[", "t", "]"}], ",", 
              RowBox[{"L", "[", "t", "]"}]}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"PsbS", "'"}], "[", "t", "]"}], "==", 
            RowBox[{"PsbSRate", "[", 
             RowBox[{
              RowBox[{"PQ", "[", "t", "]"}], ",", 
              RowBox[{"PIox", "[", "t", "]"}], ",", 
              RowBox[{"Zea", "[", "t", "]"}], ",", 
