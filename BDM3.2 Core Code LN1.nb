              RowBox[{
              "datMag", ",", "datPh", ",", "pMag", ",", "pPh", ",", "out"}], 
              "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"vals", ":", 
                RowBox[{"{", 
                 RowBox[{"fHz", ",", "mag", ",", "ph", ",", "T"}], "}"}]}], "->", 
               RowBox[{"we", " ", "want", " ", 
                RowBox[{"{", 
                 RowBox[{"T", ",", "mag"}], "}"}], " ", "and", " ", 
                RowBox[{"{", 
                 RowBox[{"T", ",", 
                  RowBox[{"ph", 
                   RowBox[{"(", "deg", ")"}]}]}], "}"}]}]}], "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"datMag", "=", 
               RowBox[{"SortBy", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"vals", "/.", " ", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"f_", ",", "mag_", ",", "ph_", ",", "T_"}], "}"}],
                     ":>", 
                    RowBox[{"{", 
                    RowBox[{"T", ",", "mag"}], "}"}]}]}], ")"}], ",", 
                 "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"datPh", "=", 
               RowBox[{"SortBy", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"vals", "/.", " ", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"f_", ",", "mag_", ",", "ph_", ",", "T_"}], "}"}],
                     ":>", 
                    RowBox[{"{", 
                    RowBox[{"T", ",", 
                    RowBox[{"ph", "*", 
                    RowBox[{"180.", "/", "Pi"}]}]}], "}"}]}]}], ")"}], ",", 
                 "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"pMag", "=", 
               RowBox[{"ListLogLinearPlot", "[", 
                RowBox[{"datMag", ",", 
