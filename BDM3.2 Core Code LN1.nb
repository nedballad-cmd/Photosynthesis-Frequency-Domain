Cell[CellGroupData[{

Cell[TextData[StyleBox["IV.2 Period sweep: steady-state response across \
oscillation periods",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.7803921568627451, 0.4235294117647059, 0.1607843137254902]]], "Subsection",
 CellFrame->{{0, 0}, {0.5, 0.5}},
 CellFrameColor->RGBColor[0.6, 0.4, 0.2],
 CellChangeTimes->{{3.9316167181482306`*^9, 3.931616725207141*^9}, 
   3.9316172604007163`*^9, {3.931617329225854*^9, 3.931617331570511*^9}, {
   3.931618560961228*^9, 3.931618561886388*^9}, {3.931758655571293*^9, 
   3.9317586654545097`*^9}, {3.9317587010901165`*^9, 3.931758757425419*^9}, {
   3.931759443826582*^9, 3.9317594539576263`*^9}, {3.931765976850231*^9, 
   3.931765981879921*^9}, 3.931766325094534*^9, {3.931771477482258*^9, 
   3.9317715012478504`*^9}, 3.9317718408597984`*^9, 3.9666257266214294`*^9, {
   3.966625762946089*^9, 3.9666257757482033`*^9}, {3.9666269362883205`*^9, 
   3.9666269365353165`*^9}, {3.9772096545071354`*^9, 
   3.9772096711677074`*^9}, {3.977335464650997*^9, 3.977335471076271*^9}, {
   3.97754633709873*^9, 3.977546403612154*^9}, {3.9775468481231575`*^9, 
   3.9775468584734535`*^9}, {3.9775468989944134`*^9, 
   3.9775469230248737`*^9}, {3.977550373798399*^9, 3.977550377315895*^9}, 
   3.977560552354868*^9, {3.9775605911970863`*^9, 3.977560628027954*^9}, 
   3.9778475417165565`*^9, {3.9778476734489193`*^9, 3.97784770301062*^9}, 
   3.977848200854473*^9},
 FontSize->16,
 FontWeight->Bold,ExpressionUUID->"2493b6ee-376b-384b-9346-745cca8f3e17"],

Cell[TextData[{
 "- Applies the IV.1 analysis across a range of forcing periods\n- Handles \
convergence failures robustly\n- Collects all results into a single index for \
downstream analysis\n\n",
 StyleBox["Overview.",
  FontWeight->"Bold"],
 "\nThis section performs a batch analysis over a range of forcing periods. \
For each period in the specified list, the steady repeating response of the \
system is computed using the single-period analysis defined above. The sweep \
collects convergence information, diagnostics, and export paths into a single \
index for downstream analysis.\n\n",
 StyleBox["Methodological details.",
  FontWeight->"Bold"],
 "\nThe sweep iterates the single-period analysis function over all values in \
Tlist. Each run independently constructs the ODE system for the given forcing \
period, iterates the Poincar\[EAcute] map until convergence (or failure), and\
\[LongDash]upon successful convergence\[LongDash]computes steady-state cycle \
diagnostics and exports period-specific results.\nResults from all runs are \
stored as a list of structured associations, each labeled by its \
corresponding forcing period and success status. Runs that fail to converge \
or encounter numerical issues are flagged but do not interrupt the sweep. \
Upon completion, a consolidated index file is written to disk, containing the \
full sweep metadata, per-period results, and file paths to exported \
diagnostics.\nThis index enables rapid post-processing, comparison across \
forcing periods, and re-analysis without rerunning the underlying simulations."
}], "Text",
 CellChangeTimes->{
  3.977847614353298*^9, 3.9778477181402855`*^9, {3.9778482276991234`*^9, 
   3.977848247700964*^9}, {3.9778487250894165`*^9, 
   3.9778487432484474`*^9}},ExpressionUUID->"c8e6416f-3d36-b743-b4ee-\
3c47eae48529"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"runID0", "=", 
   RowBox[{"DateString", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<ISODate\>\"", ",", "\"\<  T\>\"", ",", "\"\<Hour24\>\"", 
      ",", "\"\<-\>\"", ",", "\"\<Minute\>\"", ",", "\"\<-\>\"", 
      ",", "\"\<Second\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"runDir", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"baseDir", ",", "runID0"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Quiet", "@", 
    RowBox[{"CreateDirectory", "[", 
     RowBox[{"runDir", ",", 
      RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"isOK", "[", "r_", "]"}], ":=", 
    RowBox[{
     RowBox[{"AssociationQ", "[", "r", "]"}], "&&", 
     RowBox[{"TrueQ", "@", 
      RowBox[{"Lookup", "[", 
       RowBox[{"r", ",", "\"\<Success\>\"", ",", "False"}], "]"}]}]}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"progressI", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"progressT", "=", 
   RowBox[{"Missing", "[", "\"\<None\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tStartSweep", "=", 
    RowBox[{"AbsoluteTime", "[", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"results", "=", 
    RowBox[{"Monitor", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"progressI", "=", "i"}], ";", "\[IndentingNewLine]", 
         RowBox[{"progressT", "=", 
          RowBox[{"Tlist", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"runOneT", "[", 
          RowBox[{"runID0", ",", 
           RowBox[{"N", "@", "progressT"}], ",", 
           RowBox[{"\"\<PrintSummary\>\"", "->", "False"}], ",", 
           RowBox[{"\"\<Export\>\"", "->", "True"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "Tlist", "]"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<T sweep: \>\"", ",", 
            RowBox[{"Dynamic", "@", "progressI"}], ",", "\"\< / \>\"", ",", 
            RowBox[{"Length", "[", "Tlist", "]"}], 
            ",", "\"\<    Current T = \>\"", ",", 
            RowBox[{"Dynamic", "@", "progressT"}]}], "}"}], "]"}], ",", 
         RowBox[{"ProgressIndicator", "[", 
          RowBox[{
           RowBox[{"Dynamic", "@", "progressI"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"Length", "[", "Tlist", "]"}]}], "}"}]}], "]"}]}], "}"}],
        "]"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "results", "]"}], "=!=", 
      RowBox[{"Length", "[", "Tlist", "]"}]}], ",", 
     RowBox[{
     "Print", "[", "\"\<WARNING: results length != Tlist length.\>\"", 
      "]"}]}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"fails", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"results", ",", 
     RowBox[{"Not", "@*", "isOK"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nSuccess", "=", 
   RowBox[{"Count", "[", 
    RowBox[{"results", ",", 
     RowBox[{"_", "?", "isOK"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nFail", "=", 
    RowBox[{"Length", "@", "fails"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "helper"}]}], " ", "to", " ", "extract", " ", "paired", " ",
      "observable", " ", 
     RowBox[{"differences", "--"}]}], "-"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"deltaData", "[", 
     RowBox[{"keyMean_", ",", "keyConst_"}], "]"}], ":=", 
    RowBox[{"Cases", "[", 
     RowBox[{"results", ",", 
      RowBox[{
       RowBox[{"a_Association", "/;", 
        RowBox[{
         RowBox[{"NumericQ", "@", 
          RowBox[{"Lookup", "[", 
           RowBox[{"a", ",", "\"\<T\>\"", ",", 
            RowBox[{"Missing", "[", "]"}]}], "]"}]}], "&&", 
         RowBox[{"NumericQ", "@", 
          RowBox[{"Lookup", "[", 
           RowBox[{"a", ",", "keyMean", ",", 
            RowBox[{"Missing", "[", "]"}]}], "]"}]}], "&&", 
         RowBox[{"NumericQ", "@", 
          RowBox[{"Lookup", "[", 
           RowBox[{"a", ",", "keyConst", ",", 
            RowBox[{"Missing", "[", "]"}]}], "]"}]}]}]}], ":>", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "[", "\"\<T\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"Lookup", "[", 
           RowBox[{"a", ",", "keyMean"}], "]"}], "-", 
          RowBox[{"Lookup", "[", 
           RowBox[{"a", ",", "keyConst"}], "]"}]}]}], "}"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"chlFDeltaData", "=", 
   RowBox[{"deltaData", "[", 
