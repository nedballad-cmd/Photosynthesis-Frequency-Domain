Cell[CellGroupData[{

Cell["1.3.1 Defining ODEs system and rates", "Subsection",
 CellChangeTimes->{{3.9317665569203224`*^9, 3.9317666152479057`*^9}, {
   3.9317668661062584`*^9, 3.9317668702815895`*^9}, 3.9317718408597984`*^9, {
   3.9666215604821815`*^9, 3.966621563619461*^9}, {3.977375505335844*^9, 
   3.9773755126954784`*^9}, {3.977375723515148*^9, 3.9773757263277016`*^9}, {
   3.9777433671977386`*^9, 3.977743370398594*^9}},
 FontSize->14,ExpressionUUID->"a95ccb27-0bda-2d4c-973e-7245de8e876d"],

Cell["\<\
This section defines the dynamical state variables of the model and \
constructs the right-hand side (RHS) of the system of ordinary differential \
equations in a form suitable for numerical integration.
The list stateVars specifies the ordering of the state variables used \
consistently throughout the notebook. This ordering is important, as it \
determines how state vectors are passed to and returned from numerical solvers.
The function ODESystem[...] defines the complete RHS of the dynamical system \
as a vector-valued function. Each argument corresponds to one state variable, \
followed by the instantaneous light intensity I. The function returns a list \
of six expressions, each representing the time derivative of the \
corresponding state variable. Inline comments indicate the biological \
interpretation of each equation.
All arguments are guarded with ?NumericQ, ensuring that the RHS is evaluated \
only for numerical inputs. This is essential for stable and efficient use \
with NDSolve, and prevents unintended symbolic evaluation.
A sanity check evaluates the RHS at a representative numerical point to \
confirm that the output is a numeric vector of the correct length. Execution \
is aborted if this condition is not met.
The helper function ODEVec is a lightweight wrapper around ODESystem, \
introduced to simplify later reuse and to ensure that the full RHS vector is \
computed only once per evaluation site.
Individual rate functions (e.g. PQRate, ZeaRate) extract single components of \
the RHS vector. This avoids code duplication and guarantees consistency \
between the full system definition and any component-wise diagnostics or \
post-processing.
Finally, optional convenience wrappers (RHSI and RHSt) provide alternative \
interfaces in which the RHS is expressed either as a function of light \
intensity or as an explicit function of time via the light forcing function. \
These forms are useful for interfacing with different numerical solvers and \
analysis routines, but do not alter the core model definition.\
\>", "Text",
 CellChangeTimes->{{3.977799977459152*^9, 
  3.9777999922867794`*^9}},ExpressionUUID->"bf4bd38c-aeda-124d-97a6-\
59690fa6862d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"stateVars", "=", 
    RowBox[{"{", 
     RowBox[{
     "PQ", ",", "PIox", ",", "Zea", ",", "PsbS", ",", "HL", ",", "ATP"}], 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "ODESystem", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ODESystem", "::", "nnum"}], 
    "=", "\"\<Non-numeric ODESystem output. \
Inputs={PQ,PIox,Zea,PsbS,HL,ATP,L}=`1`. Output vector=`2`.\>\""}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ODESystem", "[", 
     RowBox[{
      RowBox[{"PQ_", "?", "NumericQ"}], ",", 
      RowBox[{"PIox_", "?", "NumericQ"}], ",", 
      RowBox[{"Zea_", "?", "NumericQ"}], ",", 
      RowBox[{"PsbS_", "?", "NumericQ"}], ",", 
      RowBox[{"HL_", "?", "NumericQ"}], ",", 
      RowBox[{"ATP_", "?", "NumericQ"}], ",", 
      RowBox[{"L_", "?", "NumericQ"}]}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "vec", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vec", "=", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"v2ALG", "[", 
               RowBox[{"PQ", ",", "PIox"}], "]"}], "-", 
              RowBox[{"v1ALG", "[", 
               RowBox[{"Zea", ",", "PsbS", ",", "L", ",", "PQ"}], "]"}]}], 
             ")"}], "/", "2"}], "+", 
           RowBox[{"v8ALG", "[", "PQ", "]"}]}], ",", 
          RowBox[{"(*", 
           RowBox[{"PQ", " ", "pool"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"vIALG", "[", 
            RowBox[{"L", ",", "PIox"}], "]"}], "-", 
           RowBox[{"v2ALG", "[", 
            RowBox[{"PQ", ",", "PIox"}], "]"}]}], ",", 
          RowBox[{"(*", 
           RowBox[{"PSI", " ", "donor"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"v3ALG", "[", 
            RowBox[{"Zea", ",", "HL"}], "]"}], "-", 
           RowBox[{"v4ALG", "[", "Zea", "]"}]}], ",", 
          RowBox[{"(*", "Zea", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"v9ALG", "[", 
            RowBox[{"PsbS", ",", "HL"}], "]"}], "-", 
           RowBox[{"v10ALG", "[", 
            RowBox[{"PsbS", ",", "HL"}], "]"}]}], ",", 
          RowBox[{"(*", "PsbS", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"bH", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"vIIALG", "[", 
                 RowBox[{"Zea", ",", "PsbS", ",", "L", ",", "PQ"}], "]"}], "+", 
                RowBox[{"v2ALG", "[", 
                 RowBox[{"PQ", ",", "PIox"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"NA", "*", "volLum"}], ")"}]}], "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"14", "/", "3"}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{"volStr", "/", "volLum"}], ")"}], "*", 
              RowBox[{"v5ALG", "[", 
               RowBox[{"ATP", ",", "HL"}], "]"}]}], "-", 
             RowBox[{"v7ALG", "[", 
              RowBox[{"ATP", ",", "HL"}], "]"}]}], ")"}]}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"lumen", " ", "H"}], "+"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"v5ALG", "[", 
            RowBox[{"ATP", ",", "HL"}], "]"}], "-", 
           RowBox[{"v6ALG", "[", 
            RowBox[{"ATP", ",", "HL"}], "]"}]}]}], 
         RowBox[{"(*", "ATP", "*)"}], "\[IndentingNewLine]", "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"$ODEDebug", "&&", 
          RowBox[{"!", 
           RowBox[{"VectorQ", "[", 
            RowBox[{"vec", ",", "NumericQ"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"ODESystem", "::", "nnum"}], ",", 
            RowBox[{"{", 
             RowBox[{
             "PQ", ",", "PIox", ",", "Zea", ",", "PsbS", ",", "HL", ",", 
              "ATP", ",", "L"}], "}"}], ",", "vec"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Abort", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";", "\[IndentingNewLine]", "vec"}]}], "\n", "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", "sanity"}]}], " ", 
    RowBox[{"check", ":", 
     RowBox[{"numeric", " ", 
      RowBox[{
       RowBox[{"output", "--"}], "--"}]}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"test", "=", 
       RowBox[{"ODESystem", "@@", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.1", ",", "6"}], "]"}], ",", "100"}], "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"VectorQ", "[", 
          RowBox[{"test", ",", "NumericQ"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
         "Print", 
          "[", "\"\<ODESystem sanity check failed: non-numeric output\>\"", 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
