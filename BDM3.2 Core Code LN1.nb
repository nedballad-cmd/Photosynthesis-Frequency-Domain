Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "formatTTag", ",", "runPeriodDir", ",", "exportStem", ",", 
     "exportPdfPath", ",", "exportXlsxPath"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"formatTTag", "[", 
     RowBox[{
      RowBox[{"T_", "?", "NumericQ"}], ",", 
      RowBox[{"sig_", ":", "6"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Tval", "=", 
        RowBox[{"N", "@", "T"}]}], "}"}], ",", 
      RowBox[{"\"\<T\>\"", "<>", 
       RowBox[{"StringReplace", "[", 
        RowBox[{
         RowBox[{"ToString", "@", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"Tval", ",", 
            RowBox[{"{", 
             RowBox[{"Infinity", ",", "sig"}], "}"}], ",", 
            RowBox[{"NumberPadding", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<\>\"", ",", "\"\<\>\""}], "}"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\< \>\"", "->", "\"\<\>\""}], ",", 
           RowBox[{"\"\<*^\>\"", "->", "\"\<e\>\""}], ",", 
           RowBox[{"\"\<.\>\"", "->", "\"\<p\>\""}], ",", 
           RowBox[{"\"\<-\>\"", "->", "\"\<m\>\""}], ",", 
           RowBox[{"\"\<+\>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}], 
       "<>", "\"\<s\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runPeriodDir", "[", 
     RowBox[{"baseDir_String", ",", "runID_String", ",", 
      RowBox[{"T_", "?", "NumericQ"}], ",", 
      RowBox[{"sig_", ":", "6"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "dir", "}"}], ",", 
      RowBox[{
       RowBox[{"dir", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"baseDir", ",", "runID", ",", 
           RowBox[{"formatTTag", "[", 
            RowBox[{"T", ",", "sig"}], "]"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Quiet", "@", 
        RowBox[{"CreateDirectory", "[", 
         RowBox[{"dir", ",", 
          RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", "dir"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exportStem", "[", 
     RowBox[{"T_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"formatTTag", "[", 
     RowBox[{"T", ",", "6"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exportPdfPath", "[", 
     RowBox[{"baseDir_String", ",", 
      RowBox[{"T_", "?", "NumericQ"}], ",", "what_String"}], "]"}], ":=", 
    RowBox[{"uniqueFile", "@", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"baseDir", ",", 
        RowBox[{"what", "<>", "\"\<_\>\"", "<>", 
         RowBox[{"exportStem", "[", "T", "]"}], "<>", "\"\<.pdf\>\""}]}], 
       "}"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exportXlsxPath", "[", 
     RowBox[{"baseDir_String", ",", 
      RowBox[{"T_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"uniqueFile", "@", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"baseDir", ",", 
        RowBox[{"\"\<SteadyState_\>\"", "<>", 
         RowBox[{"exportStem", "[", "T", "]"}], "<>", "\"\<.xlsx\>\""}]}], 
       "}"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"uniqueFile", "@", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"baseDir", ",", 
      RowBox[{"\"\<SteadyState_\>\"", "<>", 
       RowBox[{"exportStem", "[", "T", "]"}], "<>", "\"\<.xlsx\>\""}]}], 
     "}"}], "]"}]}], ";"}]}], "Input",
