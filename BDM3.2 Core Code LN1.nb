Cell[TextData[StyleBox["III.1 Numerical integration setup",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.7803921568627451, 0.4235294117647059, 0.1607843137254902]]], "Subsection",
