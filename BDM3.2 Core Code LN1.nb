       RowBox[{"\"\<Convergence plot written: \>\"", ",", "convPlotPath"}], 
       "]"}], ";"}]}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"floquetData", "=!=", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{
      RowBox[{"floquetPlot", "=", 
       RowBox[{"ListLogLinearPlot", "[", 
        RowBox[{"floquetData", ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
