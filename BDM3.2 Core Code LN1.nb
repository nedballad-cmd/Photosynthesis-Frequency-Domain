Cell[CellGroupData[{

Cell[TextData[StyleBox["Legend to the state variables and model parameters",
 FontWeight->"Plain"]], "Subsection",
 CellChangeTimes->{
  3.9316159505174522`*^9, {3.931758389398098*^9, 3.9317583922576103`*^9}, 
   3.9317718408597984`*^9, {3.977209361249815*^9, 3.977209381369396*^9}},
 FontSize->14,
 FontWeight->Bold,ExpressionUUID->"b9928017-976e-464f-9e7a-b0291067bd83"],

Cell[TextData[{
 StyleBox["State variables (time-dependent)",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["\nThe state variables represent dynamic pools or fractions whose \
time evolution is governed by the system of ordinary differential equations \
defined below. All state variables are bounded either by conservation \
relations (total pools) or by normalization constraints (fractions).",
  FontSlant->"Italic"],
 "\n\nPQ(t) ",
 StyleBox["\[LongDash] oxidized plastoquinone pool (total plastoquinone pool \
= PQtot)",
  FontSlant->"Italic"],
 "\nPIox(t) ",
 StyleBox["\[LongDash] oxidized plastocyanin pool (total plastocyanin pool = \
PItot)",
  FontSlant->"Italic"],
 "\nZea(t) ",
 StyleBox["\[LongDash] fraction of zeaxanthin in the xanthophyll cycle",
  FontSlant->"Italic"],
 "\nPsbS(t) ",
 StyleBox["\[LongDash] fraction of protonated PsbS protein",
  FontSlant->"Italic"],
 "\nHL(t) ",
 StyleBox["\[LongDash] luminal proton concentration (or a related variable \
representing lumen acidification)",
  FontSlant->"Italic"],
 "\nATP(t) ",
 StyleBox["\[LongDash] ATP pool (total adenylate pool = Atot)",
  FontSlant->"Italic"],
 "\n\n",
 StyleBox["Model parameters: definitions and physical meaning",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\n",
 StyleBox["Stoichiometry and pool sizes",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 "\nnPSII ",
 StyleBox["\[LongDash] number of PSII units per photosynthetic unit",
  FontSlant->"Italic"],
 "\nnPSI ",
 StyleBox["\[LongDash] number of PSI units per photosynthetic unit",
  FontSlant->"Italic"],
 "\nPQtot ",
 StyleBox["\[LongDash] total plastoquinone pool",
  FontSlant->"Italic"],
 "\nPItot ",
 StyleBox["\[LongDash] total pool of PSI donors",
  FontSlant->"Italic"],
 "\nAtot ",
 StyleBox["\[LongDash] total adenylate pool",
  FontSlant->"Italic"],
 "\n\n",
 StyleBox["Rate constants",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 "\nk1p, k1m ",
 StyleBox["\[LongDash] effective forward and backward rates of electron \
transfer from PSII to the plastoquinone pool ",
  FontSlant->"Italic"],
 "\nk2p, k2m ",
 StyleBox["\[LongDash] effective forward and backward rates of electrons from \
the plastoquinone pool towards PSI",
  FontSlant->"Italic"],
 "\nk3-k10 ",
 StyleBox["\[LongDash] rate constants of electron transport, proton transfer, \
and ATP synthesis steps",
  FontSlant->"Italic"],
 "\n\[Sigma]I0 ",
 StyleBox["\[LongDash] effective light absorption cross section of PSI",
  FontSlant->"Italic"],
 "\n\[Sigma]II0 ",
 StyleBox["\[LongDash] effective light absorption cross section of PSII",
  FontSlant->"Italic"],
 "\nL12 ",
 StyleBox["\[LongDash] characteristic light intensity (e.g. half-saturation \
or regulatory threshold)",
  FontSlant->"Italic"],
 "\n\n",
 StyleBox["Regulatory and biophysical parameters\n",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 "FQmaxPsbS ",
 StyleBox["\[LongDash] maximum contribution of PsbS-dependent \
non-photochemical quenching",
  FontSlant->"Italic"],
 "\nFQmaxZea ",
 StyleBox["\[LongDash] maximum contribution of zeaxanthin-dependent \
non-photochemical quenching",
  FontSlant->"Italic"],
 "\nnPsbS ",
 StyleBox["\[LongDash] Hill coefficient for PsbS-dependent quenching",
  FontSlant->"Italic"],
 "\nnZea ",
 StyleBox["\[LongDash] Hill coefficient for zeaxanthin-dependent quenching",
  FontSlant->"Italic"],
 "\nkQPsbS ",
 StyleBox["\[LongDash] scaling constant for PsbS-dependent quenching",
  FontSlant->"Italic"],
 "\nkQZea ",
 StyleBox["\[LongDash] scaling constant for zeaxanthin-dependent quenching",
  FontSlant->"Italic"],
 "\nPhimax ",
 StyleBox["\[LongDash] maximum photochemical efficiency",
  FontSlant->"Italic"],
 "\n\n",
 StyleBox["Proton and volume-related parameters\n",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 "bH \[LongDash] ",
 StyleBox["buffering capacity relating proton flux to lumen proton \
concentration",
  FontSlant->"Italic"],
 "\nHstroma ",
 StyleBox["\[LongDash] reference proton concentration in the stroma",
  FontSlant->"Italic"],
 "\nvolLum ",
 StyleBox["\[LongDash] lumen volume",
  FontSlant->"Italic"],
 "\nvolStr ",
 StyleBox["\[LongDash] stroma volume",
  FontSlant->"Italic"],
 "\na ",
 StyleBox["\[LongDash] scaling factor coupling luminal proton concentration \
(HL) to ATP synthesis/hydrolysis",
  FontSlant->"Italic"],
 "\n\n",
 StyleBox["Physical constants",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 "\nNA ",
 StyleBox["\[LongDash] Avogadro constant",
  FontSlant->"Italic"]
}], "Text",
