          "sheet", " ", "per", " ", 
          RowBox[{"signal", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"frf1XLSX", "=", 
        RowBox[{"uniqueFile", "@", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"sweepDir", ",", 
            
            RowBox[{"\"\<FRF1Sweep_\>\"", "<>", "runID0", 
             "<>", "\"\<.xlsx\>\""}]}], "}"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"frf1SheetsRules", "=", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"sig", ",", "vals"}], "}"}], ",", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"rows", "=", 
                RowBox[{"SortBy", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"vals", "/.", " ", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"f_", ",", "mag_", ",", "ph_", ",", "T_"}], "}"}],
                     ":>", 
                    RowBox[{"{", 
                    RowBox[{"T", ",", "f", ",", "mag", ",", "ph"}], "}"}]}]}],
                    ")"}], ",", "First"}], "]"}]}], "}"}], ",", 
              RowBox[{
               RowBox[{"StringTake", "[", 
                RowBox[{
                 RowBox[{"ToString", "[", "sig", "]"}], ",", 
                 RowBox[{"UpTo", "[", "31", "]"}]}], "]"}], "->", 
               RowBox[{"Prepend", "[", 
                RowBox[{"rows", ",", 
                 RowBox[{"{", 
                  
                  RowBox[{"\"\<T_used (s)\>\"", ",", "\"\<f (Hz)\>\"", 
                   ",", "\"\<|G1|\>\"", ",", "\"\<phase1 (rad)\>\""}], 
                  "}"}]}], "]"}]}]}], "]"}]}], "]"}], ",", "frf1BySig"}], 
         "]"}]}], ";", "\n", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
