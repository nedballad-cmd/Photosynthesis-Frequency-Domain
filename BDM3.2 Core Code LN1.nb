                    RowBox[{"[", "5", "]"}], "]"}]}], ",", 
                    RowBox[{"toNum", "@", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "6", "]"}], "]"}]}]}], "}"}], "&"}], ")"}], "/@",
                  "rows"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"rows", "=", 
                RowBox[{"Select", "[", 
                 RowBox[{"rows", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"StringQ", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "&&", 
                    RowBox[{"IntegerQ", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "&&", 
                    RowBox[{"NumericQ", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "6", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}],
                ";", "\[IndentingNewLine]", 
