              RowBox[{"HL", "[", "t", "]"}], ",", 
              RowBox[{"ATP", "[", "t", "]"}], ",", 
              RowBox[{"L", "[", "t", "]"}]}], "]"}]}]}], 
          "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "ODEs"}]}], "\[IndentingNewLine]", "]"}]}], 
