Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "dominantMultiplierByPoincare", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "dominantMultiplierByPoincare", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<RemoveNearOne\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<OneTol\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "3"}]}]}], ",", 
      RowBox[{"\"\<Clip\>\"", "->", "None"}], ",", 
      RowBox[{"\"\<DeltaClip\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "2"}]}]}], "}"}]}]}], "   ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"floor", "/", "ceiling"}], " ", "for", " ", "delta"}], "*)"}], 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dominantMultiplierByPoincare", "[", 
     RowBox[{"stepOnePeriod_", ",", "xStar_", ",", 
      RowBox[{"eps_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "=", "xStar"}], ",", "n", ",", "clip", ",", "remove1Q", ",",
         "oneTol", ",", "deltaClip", ",", "clipF", ",", "colFor", ",", "cols",
         ",", "J", ",", "evals", ",", "absE", ",", "idxNear1", ",", 
        "stable"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", 
          RowBox[{"options", "--"}]}]}], "-"}], "*)"}], 
      RowBox[{
       RowBox[{"clip", "=", 
        RowBox[{"OptionValue", "[", "\"\<Clip\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"remove1Q", "=", 
        RowBox[{"TrueQ", "@", 
         RowBox[{"OptionValue", "[", "\"\<RemoveNearOne\>\"", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"oneTol", "=", 
        RowBox[{"OptionValue", "[", "\"\<OneTol\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"deltaClip", "=", 
        RowBox[{"OptionValue", "[", "\"\<DeltaClip\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", 
           RowBox[{"guards", "--"}]}]}], "-"}], "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"VectorQ", "[", 
           RowBox[{"x", ",", "NumericQ"}], "]"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Missing", "[", "\"\<BadXStar\>\"", "]"}], "]"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"NumericQ", "[", "eps", "]"}], "&&", 
            RowBox[{"eps", ">", "0"}]}], ")"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Missing", "[", "\"\<BadEps\>\"", "]"}], "]"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"clipF", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"clip", "===", "None"}], ",", "Identity", ",", 
          RowBox[{"Function", "[", 
           RowBox[{"z", ",", 
            RowBox[{"Clip", "[", 
             RowBox[{"z", ",", "clip"}], "]"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", "one"}]}], " ", "Jacobian", " ", "column", " ", "by", 
          " ", "centered", " ", "finite", " ", 
          RowBox[{"difference", "--"}]}], "-"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"colFor", "[", "i_Integer", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"delta", ",", "xp", ",", "xm", ",", "col"}], "}"}], ",", 
          RowBox[{
           RowBox[{"delta", "=", 
            RowBox[{"eps", "*", 
             RowBox[{"Max", "[", 
              RowBox[{"1.", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"x", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ListQ", "[", "deltaClip", "]"}], "&&", 
              RowBox[{
               RowBox[{"Length", "[", "deltaClip", "]"}], "==", "2"}]}], ",", 
             RowBox[{
              RowBox[{"delta", "=", 
               RowBox[{"Clip", "[", 
                RowBox[{"delta", ",", "deltaClip"}], "]"}]}], ";"}]}], "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"xp", "=", 
            RowBox[{"stepOnePeriod", "[", 
             RowBox[{"clipF", "@", 
              RowBox[{"ReplacePart", "[", 
               RowBox[{"x", ",", 
                RowBox[{"i", "->", 
                 RowBox[{
                  RowBox[{"x", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "+", "delta"}]}]}], 
               "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"xm", "=", 
            RowBox[{"stepOnePeriod", "[", 
             RowBox[{"clipF", "@", 
              RowBox[{"ReplacePart", "[", 
               RowBox[{"x", ",", 
                RowBox[{"i", "->", 
                 RowBox[{
                  RowBox[{"x", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "-", "delta"}]}]}], 
               "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"xp", "===", "$Failed"}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<Step failed at i=\>\"", ",", "i", 
                ",", "\"\< for +delta\>\""}], "]"}], ";", 
              RowBox[{"Return", "[", 
               RowBox[{"Missing", "[", 
                RowBox[{"\"\<StepFailedPlus\>\"", ",", "i"}], "]"}], 
               "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"xm", "===", "$Failed"}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<Step failed at i=\>\"", ",", "i", 
                ",", "\"\< for -delta\>\""}], "]"}], ";", 
              RowBox[{"Return", "[", 
               RowBox[{"Missing", "[", 
                RowBox[{"\"\<StepFailedMinus\>\"", ",", "i"}], "]"}], 
               "]"}]}]}], "]"}], ";", "\n", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"!", 
               RowBox[{"VectorQ", "[", 
                RowBox[{"xp", ",", "NumericQ"}], "]"}]}], "||", 
              RowBox[{"!", 
               RowBox[{"VectorQ", "[", 
                RowBox[{"xm", ",", "NumericQ"}], "]"}]}], "||", 
              RowBox[{
               RowBox[{"Length", "[", "xp", "]"}], "=!=", "n"}], "||", 
              RowBox[{
               RowBox[{"Length", "[", "xm", "]"}], "=!=", "n"}]}], ",", 
             RowBox[{"Return", "[", 
              RowBox[{"Missing", "[", 
               RowBox[{"\"\<StepFailed\>\"", ",", "i"}], "]"}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"col", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"xp", "-", "xm"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", "delta"}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"!", 
               RowBox[{"VectorQ", "[", 
                RowBox[{"col", ",", "NumericQ"}], "]"}]}], "||", 
              RowBox[{"!", 
               RowBox[{"FreeQ", "[", 
                RowBox[{"col", ",", 
                 RowBox[{
                 "Indeterminate", "|", "ComplexInfinity", "|", 
                  "DirectedInfinity"}]}], "]"}]}]}], ",", 
             RowBox[{"Return", "[", 
              RowBox[{"Missing", "[", 
               RowBox[{"\"\<BadJacobianCol\>\"", ",", "i"}], "]"}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", "col"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cols", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"colFor", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"AnyTrue", "[", 
          RowBox[{"cols", ",", 
           RowBox[{
            RowBox[{"MatchQ", "[", 
             RowBox[{"#", ",", "_Missing"}], "]"}], "&"}]}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"First", "@", 
           RowBox[{"Select", "[", 
            RowBox[{"cols", ",", 
             RowBox[{
              RowBox[{"MatchQ", "[", 
               RowBox[{"#", ",", "_Missing"}], "]"}], "&"}]}], "]"}]}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"J", "=", 
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "cols", "]"}], ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "12"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"MatrixQ", "[", 
           RowBox[{"J", ",", "NumericQ"}], "]"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Missing", "[", "\"\<BadJacobian\>\"", "]"}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"J", ",", 
            RowBox[{
            "Indeterminate", "|", "ComplexInfinity", "|", 
             "DirectedInfinity"}]}], "]"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Missing", "[", "\"\<BadJacobian\>\"", "]"}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"evals", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"Eigenvalues", "[", 
            RowBox[{
             RowBox[{"Chop", "[", 
              RowBox[{"J", ",", 
               RowBox[{"10", "^", 
                RowBox[{"-", "10"}]}]}], "]"}], ",", 
             RowBox[{"Method", "->", "\"\<Balance\>\""}]}], "]"}], ",", 
           "$Failed"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"evals", "===", "$Failed"}], "||", 
          RowBox[{"!", 
           RowBox[{"VectorQ", "[", 
            RowBox[{"evals", ",", "NumericQ"}], "]"}]}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Missing", "[", "\"\<EigenFailed\>\"", "]"}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"absE", "=", 
        RowBox[{"Abs", "[", "evals", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"remove1Q", "&&", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"absE", "-", "1"}], "]"}], "]"}], "<", "oneTol"}]}], ",", 
         RowBox[{
          RowBox[{"idxNear1", "=", 
           RowBox[{"First", "@", 
            RowBox[{"Ordering", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"absE", "-", "1"}], "]"}], ",", "1"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"evals", "=", 
           RowBox[{"Delete", "[", 
            RowBox[{"evals", ",", "idxNear1"}], "]"}]}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"stable", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"evals", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "#", "]"}], "<", "1"}], "&"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"stable", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Missing", "[", "\"\<NoStable\>\"", "]"}], ",", 
         RowBox[{"First", "@", 
          RowBox[{"MaximalBy", "[", 
           RowBox[{"stable", ",", "Abs"}], "]"}]}]}], "]"}]}]}], "]"}]}], 
   ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", "fallback", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dominantMultiplierByPoincare", "[", "___", "]"}], ":=", 
   RowBox[{"Missing", "[", "\"\<BadCall\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
