      RowBox[{"--", "Helper"}]}], " ", "to", " ", "build", " ", "time"}], "-", 
    RowBox[{"dependent", " ", "readouts", " ", "from", " ", "a", " ", 
     RowBox[{
      RowBox[{"solution", "--"}], "--"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "makeDerived", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeDerived", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sol", ":", 
       RowBox[{"{", "__InterpolatingFunction", "}"}]}], "/;", 
      RowBox[{
       RowBox[{"Length", "[", "sol", "]"}], "==", "6"}]}], ",", "Lfun_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
