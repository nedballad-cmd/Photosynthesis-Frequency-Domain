   RowBox[{
    RowBox[{"robustnessSummary", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"subset", ",", "eg", ",", "ep"}], "}"}], ",", 
           RowBox[{
            RowBox[{"subset", "=", 
             RowBox[{"Select", "[", 
              RowBox[{"robustnessResults", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"#", "[", "\"\<T\>\"", "]"}], "==", "Tval"}], "&&", 
                 RowBox[{
                  RowBox[{"#", "[", "\"\<SamplesPerPeriod\>\"", "]"}], "==", 
                  "npp"}], "&&", 
                 RowBox[{
                  RowBox[{"#", "[", "\"\<NoiseRatio\>\"", "]"}], "==", 
                  "level"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"eg", "=", 
             RowBox[{"Lookup", "[", 
              RowBox[{"subset", ",", "\"\<GainErrorPercent\>\""}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"ep", "=", 
             RowBox[{"Lookup", "[", 
              RowBox[{"subset", ",", "\"\<PhaseErrorDeg\>\""}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<T\>\"", "->", "Tval"}], ",", 
              RowBox[{"\"\<SamplesPerPeriod\>\"", "->", "npp"}], ",", 
              RowBox[{"\"\<NoiseRatio\>\"", "->", "level"}], ",", 
              RowBox[{"\"\<MeanGainErrorPercent\>\"", "->", 
               RowBox[{"Mean", "[", "eg", "]"}]}], ",", 
              RowBox[{"\"\<SDGainErrorPercent\>\"", "->", 
               RowBox[{"StandardDeviation", "[", "eg", "]"}]}], ",", 
              RowBox[{"\"\<RMSGainErrorPercent\>\"", "->", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"Mean", "[", 
                 RowBox[{"eg", "^", "2"}], "]"}], "]"}]}], ",", 
              RowBox[{"\"\<MeanPhaseErrorDeg\>\"", "->", 
               RowBox[{"Mean", "[", "ep", "]"}]}], ",", 
              RowBox[{"\"\<SDPhaseErrorDeg\>\"", "->", 
               RowBox[{"StandardDeviation", "[", "ep", "]"}]}], ",", 
              RowBox[{"\"\<RMSPhaseErrorDeg\>\"", "->", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"Mean", "[", 
                 RowBox[{"ep", "^", "2"}], "]"}], "]"}]}]}], "|>"}]}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"Tval", ",", "Tlist"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"npp", ",", "samplesPerPeriod"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"level", ",", "noiseLevels"}], "}"}]}], "]"}], ",", "2"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
