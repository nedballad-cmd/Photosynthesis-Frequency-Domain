          "T"}], "}"}], "--"}], "-"}]}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"distAll", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "r", "}"}], ",", 
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{"Reap", "[", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
