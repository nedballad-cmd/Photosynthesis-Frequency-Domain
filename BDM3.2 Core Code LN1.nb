       ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"endObsTable", "=", "\[IndentingNewLine]", 
     RowBox[{"Cases", "[", 
      RowBox[{"results", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"a_Association", "/;", 
