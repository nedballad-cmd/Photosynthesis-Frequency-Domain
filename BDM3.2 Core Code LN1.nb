Cell[CellGroupData[{

Cell["\<\
II.1.1 Calculating the steady-state values that correspond to the constant \
light constL and Dark, initial conditions.\
\>", "Subsubsection",
 CellChangeTimes->{{3.9317665569203224`*^9, 3.9317666152479057`*^9}, {
   3.9317668002107353`*^9, 3.931766851272703*^9}, {3.931766925971487*^9, 
   3.9317669374121017`*^9}, {3.9317669937104244`*^9, 
   3.9317669943481693`*^9}, {3.93176798234107*^9, 3.93176798743906*^9}, {
   3.931768149862772*^9, 3.9317681643949604`*^9}, 3.9317718408597984`*^9, {
   3.977199567232353*^9, 3.9771995880787945`*^9}, {3.977746007893652*^9, 
   3.9777460159015465`*^9}},
 FontSize->14,ExpressionUUID->"d333b06a-9f40-5745-9535-f7bfe5b95069"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Steady", "-", 
    RowBox[{"state", " ", "unknowns", " ", 
     RowBox[{"(", 
      RowBox[{"one", " ", "per", " ", "state", " ", "variable"}], ")"}]}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"varSS", "=", 
     RowBox[{"{", 
      RowBox[{
      "PQSS", ",", "PIoxSS", ",", "ZeaSS", ",", "PsbSSS", ",", "HLSS", ",", 
       "ATPSS"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Constant", "-", 
     RowBox[{"light", " ", "level", " ", "used", " ", "for", " ", "steady"}], 
     "-", 
     RowBox[{"state", " ", "solves", " ", "and", " ", "diagnostics"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L0", "=", 
     RowBox[{"N", "@", "constL"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Steady", "-", 
     RowBox[{
     "state", " ", "equations", " ", "under", " ", "constant", " ", "light", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"d", "/", "dt"}], "=", "0"}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"steadyStateEqns", "=", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"PQRate", "[", 
         RowBox[{
         "PQSS", ",", "PIoxSS", ",", "ZeaSS", ",", "PsbSSS", ",", "HLSS", ",",
           "ATPSS", ",", "L0"}], "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PIoxRate", "[", 
         RowBox[{
         "PQSS", ",", "PIoxSS", ",", "ZeaSS", ",", "PsbSSS", ",", "HLSS", ",",
           "ATPSS", ",", "L0"}], "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ZeaRate", "[", 
         RowBox[{
         "PQSS", ",", "PIoxSS", ",", "ZeaSS", ",", "PsbSSS", ",", "HLSS", ",",
           "ATPSS", ",", "L0"}], "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PsbSRate", "[", 
         RowBox[{
         "PQSS", ",", "PIoxSS", ",", "ZeaSS", ",", "PsbSSS", ",", "HLSS", ",",
           "ATPSS", ",", "L0"}], "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HLRate", "[", 
         RowBox[{
         "PQSS", ",", "PIoxSS", ",", "ZeaSS", ",", "PsbSSS", ",", "HLSS", ",",
           "ATPSS", ",", "L0"}], "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ATPRate", "[", 
         RowBox[{
         "PQSS", ",", "PIoxSS", ",", "ZeaSS", ",", "PsbSSS", ",", "HLSS", ",",
           "ATPSS", ",", "L0"}], "]"}], "==", "0"}]}], "\[IndentingNewLine]", 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Dark", " ", "steady", " ", "state", " ", "is", " ", "defined", " ", 
     "explicitly", " ", 
     RowBox[{"(", 
      RowBox[{"not", " ", "solved", " ", "via", " ", "FindRoot"}], ")"}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Solve", " ", "steady", " ", "state", " ", "under", " ", "constant", " ",
       "light", " ", "I"}], "=", "constL"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Solve", " ", "constant"}], "-", 
     RowBox[{
     "light", " ", "steady", " ", "state", " ", "with", " ", "a", " ", 
      "couple", " ", "of", " ", "guarded", " ", "fallbacks", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"quiet", " ", "unless", " ", "verbose"}], "=", "True"}], 
       ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "solveSteadyState", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"solveSteadyState", "[", 
      RowBox[{"eqns_", ",", 
       RowBox[{"verbose_", ":", "False"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "sol", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"sol", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"FindRoot", "[", 
             RowBox[{"eqns", ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"PQSS", ",", 
                RowBox[{"PQtot", "/", "2"}], ",", "0", ",", "PQtot"}], "}"}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"PIoxSS", ",", 
                RowBox[{"PItot", "/", "2"}], ",", "0", ",", "PItot"}], "}"}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"ZeaSS", ",", "0.5", ",", "0", ",", "1"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"PsbSSS", ",", "0.5", ",", "0", ",", "1"}], "}"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"HLSS", ",", 
                RowBox[{"Hstroma", "*", "10"}], ",", "Hstroma", ",", 
                RowBox[{"Hstroma", "*", "1000"}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"ATPSS", ",", 
                RowBox[{"Atot", "/", "10"}], ",", "0", ",", "Atot"}], "}"}]}],
              "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
            "$Failed"}], "\[IndentingNewLine]", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"sol", "=!=", "$Failed"}], ",", 
          RowBox[{"Return", "[", "sol", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"fallback", " ", "1"}], ":", 
          RowBox[{"widen", " ", 
           RowBox[{"HL", "/", "ATP"}], " ", "ranges", " ", "and", " ", 
           "nudge", " ", "starting", " ", "guesses"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"FindRoot", "[", "\[IndentingNewLine]", 
             RowBox[{"eqns", ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"PQSS", ",", 
                RowBox[{"0.8", " ", "PQtot"}], ",", "0", ",", "PQtot"}], 
               "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"PIoxSS", ",", 
                RowBox[{"0.2", " ", "PItot"}], ",", "0", ",", "PItot"}], 
               "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"ZeaSS", ",", "0.1", ",", "0", ",", "1"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"PsbSSS", ",", "0.1", ",", "0", ",", "1"}], "}"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"HLSS", ",", 
                RowBox[{"Hstroma", "*", "50"}], ",", 
                RowBox[{"Hstroma", "/", "10"}], ",", 
                RowBox[{"Hstroma", "*", 
                 RowBox[{"10", "^", "5"}]}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"ATPSS", ",", 
                RowBox[{"Atot", "/", "2"}], ",", "0", ",", "Atot"}], "}"}]}], 
             "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
            "$Failed"}], "\[IndentingNewLine]", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"sol", "=!=", "$Failed"}], ",", 
          RowBox[{"Return", "[", "sol", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"fallback", " ", "2"}], ":", 
          RowBox[{"try", " ", "midpoints", " ", "in", " ", "bounds", " ", 
           RowBox[{"(", 
            RowBox[{"often", " ", "stabilizes", " ", "stiff", " ", "solves"}],
             ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"FindRoot", "[", "\[IndentingNewLine]", 
             RowBox[{"eqns", ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"PQSS", ",", 
                RowBox[{"PQtot", "/", "2"}], ",", "0", ",", "PQtot"}], "}"}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"PIoxSS", ",", 
                RowBox[{"PItot", "/", "2"}], ",", "0", ",", "PItot"}], "}"}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"ZeaSS", ",", "0.5", ",", "0", ",", "1"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"PsbSSS", ",", "0.5", ",", "0", ",", "1"}], "}"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"HLSS", ",", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"Hstroma", "/", "10"}], ")"}], " ", 
                  RowBox[{"(", 
                   RowBox[{"Hstroma", "*", 
                    RowBox[{"10", "^", "5"}]}], ")"}]}], "]"}], ",", 
                RowBox[{"Hstroma", "/", "10"}], ",", 
                RowBox[{"Hstroma", "*", 
                 RowBox[{"10", "^", "5"}]}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"ATPSS", ",", 
                RowBox[{"Atot", "/", "2"}], ",", "0", ",", "Atot"}], "}"}]}], 
             "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
            "$Failed"}], "\[IndentingNewLine]", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"sol", "=!=", "$Failed"}], ",", 
          RowBox[{"Return", "[", "sol", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "@", "verbose"}], ",", 
          RowBox[{
           RowBox[{
           "Print", 
            "[", "\"\<Steady-state FindRoot failed. Try adjusting initial \
guesses/bounds, especially HLSS and ATPSS.\>\"", "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "$Failed"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Set", " ", "verbose"}], "->", 
     RowBox[{
     "True", " ", "for", " ", "a", " ", "short", " ", "diagnostic", " ", 
      "message", " ", "if", " ", "FindRoot", " ", "fails"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"steadyStateSolution", "=", 
     RowBox[{"solveSteadyState", "[", "steadyStateEqns", " ", 
      RowBox[{"(*", 
       RowBox[{",", "verbose"}], "*)"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"steadyStateSolution", "===", "$Failed"}], ",", 
      RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Remove", " ", "tiny", " ", "imaginary", " ", "parts", " ", "introduced", 
     " ", "by", " ", "numerical", " ", "solves"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"steadyStateValues", "=", 
     RowBox[{"Chop", "@", 
      RowBox[{"Re", "[", 
       RowBox[{"varSS", "/.", " ", "steadyStateSolution"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Validate", " ", "steady"}], "-", 
     RowBox[{"state", " ", "solution"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"VectorQ", "[", 
        RowBox[{"steadyStateValues", ",", "NumericQ"}], "]"}]}], ",", 
      RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Initial", " ", "conditions", " ", "for", " ", "simulations", " ", 
      "starting", " ", "from", " ", "constant"}], "-", 
     RowBox[{"light", " ", "steady", " ", "state"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "PQ0ss", ",", "PIox0ss", ",", "Zea0ss", ",", "PsbS0ss", ",", "HL0ss", ",",
        "ATP0ss"}], "}"}], "=", "steadyStateValues"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"initCondLightSS", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"PQ", "[", "0", "]"}], "==", "PQ0ss"}], ",", 
       RowBox[{
        RowBox[{"PIox", "[", "0", "]"}], "==", "PIox0ss"}], ",", 
       RowBox[{
        RowBox[{"Zea", "[", "0", "]"}], "==", "Zea0ss"}], ",", 
       RowBox[{
        RowBox[{"PsbS", "[", "0", "]"}], "==", "PsbS0ss"}], ",", 
       RowBox[{
        RowBox[{"HL", "[", "0", "]"}], "==", "HL0ss"}], ",", 
       RowBox[{
        RowBox[{"ATP", "[", "0", "]"}], "==", "ATP0ss"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Observables", " ", "at", " ", "constant"}], "-", 
     RowBox[{"light", " ", "steady", " ", "state", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"t", "=", "0"}], ",", 
        RowBox[{"I", "=", "constL"}]}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"initRulesLightSS", "=", 
     RowBox[{"initCondLightSS", "/.", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"lhs_", "==", "rhs_"}], ":>", 
        RowBox[{"(", 
         RowBox[{"lhs", "->", "rhs"}], ")"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "PQ0", ",", "PIox0", ",", "Zea0", ",", "PsbS0", ",", "HL0", ",", 
       "ATP0"}], "}"}], "=", "\[IndentingNewLine]", 
     RowBox[{"N", "@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Through", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "PQ", ",", "PIox", ",", "Zea", ",", "PsbS", ",", "HL", ",", 
            "ATP"}], "}"}], "[", "0", "]"}], "]"}], "/.", " ", 
        "initRulesLightSS"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"chlF0ConstL", "=", 
     RowBox[{"N", "@", 
      RowBox[{"FluoALG", "[", 
       RowBox[{"Zea0", ",", "PsbS0", ",", "PQ0", ",", "L0"}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"npq0ConstL", "=", 
     RowBox[{"N", "@", 
      RowBox[{"NPQALG", "[", 
       RowBox[{"Zea0", ",", "PsbS0"}], "]"}]}]}], ";"}], "\n", 
