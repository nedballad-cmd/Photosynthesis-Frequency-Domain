Cell[CellGroupData[{

Cell["U.f. cleanPairs", "Subsection",
 CellChangeTimes->{{3.9316172253028307`*^9, 3.9316172315405197`*^9}, {
   3.9316173221999707`*^9, 3.931617323622217*^9}, {3.9316264716698666`*^9, 
