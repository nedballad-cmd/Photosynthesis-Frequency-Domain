Cell[CellGroupData[{

Cell[TextData[StyleBox["IV.1 \[LongDash] Steady-state cycle diagnostics and \
light\[Dash]observable response loops (runOneT)",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.7803921568627451, 0.4235294117647059, 0.1607843137254902]]], "Subsection",
 CellFrame->{{0, 0}, {0.5, 0.5}},
 CellFrameColor->RGBColor[0.6, 0.4, 0.2],
 CellChangeTimes->{{3.9316167181482306`*^9, 3.931616725207141*^9}, 
   3.9316172604007163`*^9, {3.931617329225854*^9, 3.931617331570511*^9}, {
   3.931618560961228*^9, 3.931618561886388*^9}, {3.931758655571293*^9, 
   3.9317586654545097`*^9}, {3.9317587010901165`*^9, 3.931758757425419*^9}, {
   3.931759443826582*^9, 3.9317594539576263`*^9}, {3.931765976850231*^9, 
   3.931765981879921*^9}, 3.931766325094534*^9, {3.931771477482258*^9, 
   3.9317715012478504`*^9}, 3.9317718408597984`*^9, 3.9666257266214294`*^9, {
   3.966625762946089*^9, 3.9666257757482033`*^9}, {3.9666269362883205`*^9, 
   3.9666269365353165`*^9}, {3.9772096545071354`*^9, 
   3.9772096711677074`*^9}, {3.977335464650997*^9, 3.977335471076271*^9}, {
   3.97754633709873*^9, 3.977546403612154*^9}, {3.9775468481231575`*^9, 
   3.9775468584734535`*^9}, {3.9775468989944134`*^9, 
   3.9775469230248737`*^9}, {3.977550373798399*^9, 3.977550377315895*^9}, 
   3.977560552354868*^9, {3.9775605911970863`*^9, 3.977560628027954*^9}, 
   3.9778475417165565`*^9, {3.9778483692680283`*^9, 3.9778483874514256`*^9}},
 FontSize->16,
 FontWeight->Bold,ExpressionUUID->"04c95a4f-1125-5349-869e-6a56c533ab37"],

Cell[TextData[{
 "- Defines the single-period analysis\n- Finds the steady repeating cycle \
via the Poincar\[EAcute] map\n- Re-integrates the final cycles\n- Computes \
observables, plots loops, and exports diagnostics\n\n",
 StyleBox["Overview.",
  FontWeight->"Bold"],
 "\nThis section analyzes the steady repeating response of the system under \
periodic (oscillatory) forcing. After the Poincar\[EAcute] map has converged\
\[LongDash]meaning that the system repeats from one forcing cycle to the next\
\[LongDash]the model is re-integrated over the final cycles to produce \
high-resolution time series. These time series are used to compute \
physiological observables, generate light\[Dash]response loop plots, and \
export quantitative diagnostics.\n\n",
 StyleBox["Methodological details.",
  FontWeight->"Bold"],
 "\nStarting from the converged Poincar\[EAcute] fixed point, the system is \
re-integrated over the final forcing cycles in order to obtain \
high-resolution time series suitable for diagnostics, visualization, and \
export.\nThe state vector at the converged Poincar\[EAcute] section is first \
validated and converted into a plain numeric representation. Using this state \
as an initial condition, the ODE system is integrated over a user-specified \
number of final forcing periods. From the resulting solution, derived \
observables such as chlorophyll fluorescence (ChlF), non-photochemical \
quenching (NPQ), and oxygen evolution rate are reconstructed.\nMean values of \
selected observables over the final forcing cycle are computed and compared \
to their corresponding steady-state values under constant light. These values \
are used to annotate light\[Dash]response loop figures, which visualize the \
relationship between instantaneous light intensity and physiological \
observables over one forcing period.\nFor quantitative analysis and export, \
the final forcing cycle is sampled on a uniform grid (128 points per period). \
Discrete time series are assembled for all state variables, the light input, \
and derived observables. A discrete Fourier transform is then performed on \
each clean signal to extract the DC component and the first four harmonics, \
yielding amplitudes and phases. For convenience, analytic reconstruction \
formulas compatible with spreadsheet software are generated from the Fourier \
coefficients.\nFinally, all steady-state diagnostics\[LongDash]including \
reference steady states, final-cycle time series, Fourier spectra, and \
metadata\[LongDash]are exported to a structured Excel workbook. \
Publication-quality PDF figures of the light\[Dash]response loops are written \
to the same period-specific results directory."
}], "Text",
 CellChangeTimes->{
  3.977847614353298*^9, {3.977848062520281*^9, 3.9778480940896072`*^9}, {
   3.9778483976538353`*^9, 3.9778484063067207`*^9}, {3.9778486450763474`*^9, 
   3.9778486554097233`*^9}},
 TextJustification->1,ExpressionUUID->"0bcc16fa-55f9-5a4e-b2fa-6b3e7d2c51ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"THE", " ", "DEFINITION", " ", "CELL"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "runOneT", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "runOneT", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<PrintSummary\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<Export\>\"", "->", "True"}], ",", 
       RowBox[{"\"\<ComputeFloquet\>\"", "->", "False"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"runOneT", "[", 
      RowBox[{"runID_String", ",", 
       RowBox[{"Tval_", "?", "NumericQ"}], ",", 
       RowBox[{"opts", ":", 
        RowBox[{"OptionsPattern", "[", 
         RowBox[{"{", 
          RowBox[{"runOneT", ",", "RunByPeriods"}], "}"}], "]"}]}]}], "]"}], ":=",
      "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"per", "-", 
          RowBox[{"run", " ", "locals"}]}], "*)"}], 
        RowBox[{"ODEsLocal", ",", "L", ",", 
         RowBox[{"out", "=", "$Failed"}], ",", "t0", ",", "elapsed", ",", 
         "summary", ",", "printSummary", ",", "doExport", ",", "outDir", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"IV", ".1", " ", "locals"}], "*)"}], "Tused", ",", "vars", ",",
          "varKeysStr", ",", "normalizeXPoincare", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"<", 
           RowBox[{
            RowBox[{"--", "add"}], " ", "these"}]}], "*)"}], "kStar", ",", 
         "kConv", ",", " ", "xStar", ",", "xEnd", ",", "initEnd", ",", "tmax",
          ",", "solPlot", ",", "drvPlot", ",", "tLast0", ",", "tLast1", ",", 
         "dbgHeads", ",", "dbgVals", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "Floquet", " ", "*)"}], "doFloquet", ",", 
         "stepOnePeriod", ",", "mu", ",", "floquetMuDom", ",", 
         "floquetMuDomAbs", ",", "tFloqStart", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"<", 
           RowBox[{
            RowBox[{"--", "and"}], " ", "these"}]}], "*)"}], "chlFnum", ",", 
         "chlFmeanLast", ",", "npqMeanLast", ",", "o2MeanLast", ",", 
         "chlFconstL", ",", "npqconstL", ",", "o2constL", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"DFT", "/", "FRF"}], " ", "locals"}], "*)"}], "kmaxDFT", ",",
          "kmaxFRF", ",", "dftSheet", ",", "dftBlocks", ",", "dftCkAssoc", ",",
          "uBlock", ",", "uCk", ",", "signalsForFRF", ",", "frfHeader", ",", 
         "frfRows", ",", "frfSheet", ",", "frfPath", ",", "excelClean", ",", 
         "frfSheetXLSX", ",", "rectangularQ", ",", "sanitizeTag", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "for", " ", "adding", " ", "the", " ", "spectral", " ", 
           "dimension"}], " ", "*)"}], "nPer", ",", "takeLastPeriod", ",", 
         "periodDataForSpectra", ",", "spectraDataPath", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"<", 
           RowBox[{
            RowBox[{"--", "and"}], " ", "these"}]}], "*)"}], " ", 
         "makeInfoText", ",", "nPlot", ",", "tPlot", ",", "lightPlot", ",", 
         "chlFPlot", ",", "npqPlot", ",", "o2Plot", ",", "loopFig", ",", 
         "figChlF", ",", "figNPQ", ",", "figO2", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", "export", "*)"}], "xlsxPath", ",", "pdfChlF", ",", 
         "pdfNPQ", ",", "pdfO2", ",", "table"}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"outDir", "=", 
          RowBox[{"runPeriodDir", "[", 
           RowBox[{"baseDir", ",", "runID", ",", "Tval"}], "]"}]}], ";", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "the", " ", "directory", " ", "on", " ", "disk", " ", "where", " ", 
           "all", " ", "artifacts", " ", "for", " ", "one", " ", "run", " ", 
           "at", " ", "one", " ", "forcing", " ", "period", " ", "Tval", " ", 
           "should", " ", 
           RowBox[{"live", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"printSummary", "=", 
          RowBox[{"TrueQ", "@", 
           RowBox[{"OptionValue", "[", 
            RowBox[{"runOneT", ",", 
             RowBox[{"{", "opts", "}"}], ",", "\"\<PrintSummary\>\""}], 
            "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"doExport", "=", 
          RowBox[{"TrueQ", "@", 
           RowBox[{"OptionValue", "[", 
            RowBox[{"runOneT", ",", 
             RowBox[{"{", "opts", "}"}], ",", "\"\<Export\>\""}], "]"}]}]}], ";",
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"t0", "=", 
          RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"--", 
             RowBox[{"-", "build"}]}], " ", "ODEs", " ", "for", " ", "this", " ", 
            RowBox[{"period", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"ODEsLocal", "=", 
          RowBox[{"Flatten", "@", 
           RowBox[{"MakeODEs", "[", 
            RowBox[{"N", "@", "Tval"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"VectorQ", "[", 
             RowBox[{"ODEsLocal", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Head", "[", "#", "]"}], "===", "Equal"}], "&"}]}], 
             "]"}]}], ",", 
           RowBox[{"Return", "@", 
            RowBox[{"fail", "[", 
             RowBox[{"Tval", ",", 
              RowBox[{"<|", 
               RowBox[{
                
                RowBox[{"\"\<Message\>\"", 
                 "->", "\"\<ODEsNotEquationList\>\""}], ",", 
                RowBox[{"\"\<OutHead\>\"", "->", 
                 RowBox[{"Head", "[", "ODEsLocal", "]"}]}]}], "|>"}]}], 
             "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "local", " ", "light", " ", "wrapper", " ", "for", " ", "this", " ",
            "period"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"tt_", "?", "NumericQ"}], "]"}], ":=", 
          RowBox[{"Light", "[", 
           RowBox[{"tt", ",", "Tval"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"out", "=", 
          RowBox[{"Quiet", "@", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"RunByPeriodsIC", "[", 
              RowBox[{"ODEsLocal", ",", "initCond", ",", 
               RowBox[{"N", "@", "Tval"}], ",", 
               RowBox[{"\"\<MaxPeriods\>\"", "->", "MaxPeriods"}], ",", 
               RowBox[{"\"\<ConvergenceMetric\>\"", "->", "convMetric"}], ",", 
               RowBox[{"\"\<PrintEvery\>\"", "->", "0"}], ",", 
               RowBox[{"\"\<KeepChunkSols\>\"", "->", "False"}], ",", 
               RowBox[{"\"\<LogDir\>\"", "->", "None"}], ",", 
               RowBox[{"\"\<LogFile\>\"", "->", "None"}]}], "]"}], ",", 
             "$Failed"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"out", "===", "$Failed"}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"fail", "[", 
             RowBox[{"Tval", ",", 
              RowBox[{"<|", 
               
               RowBox[{"\"\<Message\>\"", 
                "->", "\"\<RunByPeriodsFailed\>\""}], "|>"}]}], "]"}], 
            "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"AssociationQ", "[", "out", "]"}]}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"fail", "[", 
             RowBox[{"Tval", ",", 
              RowBox[{"<|", 
               RowBox[{
                
                RowBox[{"\"\<Message\>\"", 
                 "->", "\"\<RunByPeriodsReturnedNonAssociation\>\""}], ",", 
                RowBox[{"\"\<OutHead\>\"", "->", 
                 RowBox[{"Head", "[", "out", "]"}]}]}], "|>"}]}], "]"}], 
            "]"}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"kConv", "=", 
          RowBox[{"Lookup", "[", 
           RowBox[{"out", ",", "\"\<ConvergedAtPeriod\>\"", ",", 
            RowBox[{"Missing", "[", "\"\<NotConverged\>\"", "]"}]}], "]"}]}], 
         ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"IntegerQ", "[", "kConv", "]"}]}], ",", 
           RowBox[{"Return", "@", 
            RowBox[{"fail", "[", 
             RowBox[{"Tval", ",", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Message\>\"", "->", "\"\<NotConverged\>\""}], ",", 
                RowBox[{"\"\<ConvergedAtPeriod\>\"", "->", "kConv"}]}], 
               "|>"}]}], "]"}]}]}], "]"}], ";", "\n", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"===", "===", "===", "===", "===", "===", "===", "==="}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"IV", ".1", " ", "ANALYSIS"}], "+", "EXPORT"}], "===", "===",
              "===", "===", "===", "===", "===", "==="}], "="}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "prefer", " ", "period", " ", "from", " ", "the", " ", "run", " ", 
           "if", " ", "present"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Tused", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"KeyExistsQ", "[", 
              RowBox[{"out", ",", "\"\<T\>\""}], "]"}], "&&", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"out", "[", "\"\<T\>\"", "]"}], "]"}]}], ",", 
            RowBox[{"out", "[", "\"\<T\>\"", "]"}], ",", "Tval"}], "]"}]}], ";",
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"!", 
             RowBox[{"IntegerQ", "[", "NLastPeriods", "]"}]}], "||", 
            RowBox[{"NLastPeriods", "<", "1"}]}], ",", 
