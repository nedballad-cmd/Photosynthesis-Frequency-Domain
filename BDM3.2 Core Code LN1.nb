  1],ExpressionUUID->"42171702-6151-7b47-8479-cf34405eaf2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Format", " ", "numeric", " ", "T", " ", "as", " ", "a", " ", 
     "filesystem"}], "-", 
    RowBox[{"safe", " ", "tag", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"no", " ", "\"\<.\>\""}], ",", "\"\<-\>\"", ",", "spaces", ",", 
       RowBox[{"or", " ", "\"\<*^\>\""}]}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "formatTTag", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"formatTTag", "[", 
      RowBox[{
       RowBox[{"T_", "?", "NumericQ"}], ",", 
       RowBox[{"sig_", ":", "6"}]}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "s", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{"ToString", "@", 
          RowBox[{"ScientificForm", "[", 
           RowBox[{"T", ",", "sig", ",", 
            RowBox[{"NumberFormat", "->", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{"#1", ",", "\"\<e\>\"", ",", "#3"}], "}"}], "]"}], 
               "&"}], ")"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"s", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<-\>\"", "->", "\"\<m\>\""}], ",", 
            RowBox[{"\"\<.\>\"", "->", "\"\<p\>\""}], ",", 
            RowBox[{"\"\<+\>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Generate", " ", "a", " ", "non"}], "-", 
     RowBox[{
     "existing", " ", "filename", " ", "by", " ", "appending", " ", "a", " ", 
      "numeric", " ", "suffix", " ", "if", " ", "needed"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "uniqueFile", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"uniqueFile", "[", 
      RowBox[{
       RowBox[{"path_String", "/;", 
        RowBox[{
         RowBox[{"StringLength", "[", "path", "]"}], ">", "0"}]}], ",", 
       RowBox[{"digits_", ":", "4"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dir", "=", 
          RowBox[{"DirectoryName", "[", "path", "]"}]}], ",", 
         RowBox[{"name", "=", 
          RowBox[{"FileNameTake", "[", "path", "]"}]}], ",", "base", ",", 
         "ext", ",", "cand", ",", 
         RowBox[{"i", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Quiet", "@", 
         RowBox[{"CreateDirectory", "[", 
          RowBox[{"dir", ",", 
           RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"FileExistsQ", "[", "path", "]"}]}], ",", 
          RowBox[{"Return", "[", "path", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"base", "=", 
         RowBox[{"FileBaseName", "[", "name", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ext", "=", 
         RowBox[{"FileExtension", "[", "name", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{"True", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"cand", "=", 
            RowBox[{"FileNameJoin", "@", 
             RowBox[{"{", 
              RowBox[{"dir", ",", "\[IndentingNewLine]", 
               RowBox[{"base", "<>", "\"\<-\>\"", "<>", 
                RowBox[{"IntegerString", "[", 
                 RowBox[{"i", ",", "10", ",", "digits"}], "]"}], "<>", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"ext", "===", "\"\<\>\""}], "||", 
                   RowBox[{"ext", "===", "None"}]}], ",", "\"\<\>\"", ",", 
                  RowBox[{"\"\<.\>\"", "<>", "ext"}]}], "]"}]}]}], "}"}]}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"FileExistsQ", "[", "cand", "]"}]}], ",", 
             RowBox[{"Return", "[", "cand", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"i", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
        ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Wrapper", " ", "to", " ", "accept", " ", "initial", " ", "conditions", " ",
      "as", " ", "equations", " ", "instead", " ", "of", " ", "rules"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "RunByPeriodsIC", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"RunByPeriodsIC", "[", 
      RowBox[{"odes_", ",", "init_List", ",", 
       RowBox[{"T_", "?", "NumericQ"}], ",", 
       RowBox[{"opts", ":", 
        RowBox[{"OptionsPattern", "[", "RunByPeriods", "]"}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"initRules", ",", "badLHS"}], "}"}], ",", 
       RowBox[{
        RowBox[{"initRules", "=", 
         RowBox[{"init", "/.", " ", 
          RowBox[{"Equal", "->", "Rule"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"VectorQ", "[", 
            RowBox[{"initRules", ",", 
             RowBox[{
              RowBox[{"MatchQ", "[", 
               RowBox[{"#", ",", "_Rule"}], "]"}], "&"}]}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Success\>\"", "->", "False"}], ",", 
             RowBox[{"\"\<FailAt\>\"", "->", "\"\<BadInitCond\>\""}], ",", 
             RowBox[{"\"\<init\>\"", "->", "init"}]}], "|>"}], "]"}]}], "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"badLHS", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"initRules", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"Not", "@*", 
            RowBox[{"MatchQ", "[", 
             RowBox[{"_", "[", "0", "]"}], "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"badLHS", "=!=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Success\>\"", "->", "False"}], ",", 
             RowBox[{"\"\<FailAt\>\"", "->", "\"\<BadInitLHS\>\""}], ",", 
             RowBox[{"\"\<BadLHS\>\"", "->", "badLHS"}]}], "|>"}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"RunByPeriods", "[", 
         RowBox[{"odes", ",", "initRules", ",", "T", ",", "opts"}], "]"}]}]}],
       "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Construct", " ", "filesystem"}], "-", 
     RowBox[{
     "safe", " ", "export", " ", "filenames", " ", "tagged", " ", "by", " ", 
      "the", " ", "forcing", " ", "period", " ", "T"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"exportStem", ",", "exportPdfPath", ",", "exportXlsxPath"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"exportStem", "[", 
      RowBox[{"T_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"\"\<T=\>\"", "<>", 
      RowBox[{"formatTTag", "[", "T", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"exportPdfPath", "[", 
      RowBox[{"baseDir_String", ",", 
       RowBox[{"T_", "?", "NumericQ"}], ",", "what_String"}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"uniqueFile", "@", "\[IndentingNewLine]", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"baseDir", ",", 
         RowBox[{"what", "<>", "\"\<_\>\"", "<>", 
          RowBox[{"exportStem", "[", "T", "]"}], "<>", "\"\<.pdf\>\""}]}], 
        "}"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"exportXlsxPath", "[", 
      RowBox[{"baseDir_String", ",", 
       RowBox[{"T_", "?", "NumericQ"}]}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"uniqueFile", "@", "\[IndentingNewLine]", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"baseDir", ",", 
         RowBox[{"\"\<SteadyState_\>\"", "<>", 
          RowBox[{"exportStem", "[", "T", "]"}], "<>", "\"\<.xlsx\>\""}]}], 
        "}"}], "]"}]}]}], ";"}]}]}]], "Input",
