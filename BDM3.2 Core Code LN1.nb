                    RowBox[{
                    "sig", ",", "k", ",", "fHz", ",", "aK", ",", "a1", ",", 
                    "d", ",", "T"}], "}"}]}]}], ")"}]}], ";"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"f", ",", "sumFiles"}], "}"}]}], "]"}], "]"}]}], ";", 
