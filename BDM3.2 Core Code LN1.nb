         "initStateRules"}], ")"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"2", ")"}], " ", "Steady"}], "-", 
     RowBox[{"state", " ", "observables", " ", "in", " ", "constant", " ", 
      RowBox[{"light", ":", 
       RowBox[{
       "take", " ", "from", " ", "first", " ", "successful", " ", 
        "run"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"firstOK", "=", 
     RowBox[{"FirstCase", "[", 
      RowBox[{"results", ",", 
       RowBox[{
        RowBox[{"a_Association", "/;", 
         RowBox[{"TrueQ", "@", 
          RowBox[{"Lookup", "[", 
           RowBox[{"a", ",", "\"\<Success\>\"", ",", "False"}], "]"}]}]}], ":>",
         "a"}], ",", 
       RowBox[{"Missing", "[", "\"\<NoSuccess\>\"", "]"}]}], "]"}]}], ";"}], 
