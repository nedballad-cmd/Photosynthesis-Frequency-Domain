       RowBox[{"\"\<PIox\>\"", "->", "PItot"}], ",", 
       RowBox[{"(*", 
        RowBox[{"PI", " ", "fully", " ", "oxidized"}], "*)"}], 
       "\[IndentingNewLine]", 
