                   RowBox[{"sig", "<>", "\"\<_FRF1_vs_T.pdf\>\""}]}], "}"}], 
                 "]"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"Quiet", "@", 
               RowBox[{"Check", "[", 
                RowBox[{
