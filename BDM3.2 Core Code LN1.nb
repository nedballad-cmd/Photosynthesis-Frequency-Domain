Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "cleanPairs", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cleanPairs", "[", "data_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", "=", "data"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"ListQ", "[", "d", "]"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Cases", "[", 
       RowBox[{"d", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x_", "?", "NumericQ"}], ",", 
           RowBox[{"y_", "?", "NumericQ"}]}], "}"}], ":>", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"N", "@", "x"}], ",", 
           RowBox[{"N", "@", "y"}]}], "}"}]}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\n"}], "Input",
 CellFrame->{{0, 0}, {0, 0}},
