Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "V", ".3", " ", "Periodic", " ", "resampling", " ", "Original", " ", 
      "exported", " ", "grids", " ", "include", " ", "both", " ", 
      RowBox[{"endpoints", ".", "Interpolate"}], " ", "the", " ", "stored", " ",
       "noise"}], "-", 
     RowBox[{
     "free", " ", "waveform", " ", "and", " ", "evaluate", " ", "it", " ", 
      "on", " ", "a", " ", "uniform"}]}], ",", 
    RowBox[{"endpoint", "-", 
     RowBox[{"excluded", " ", 
      RowBox[{"grid", ".", "This"}], " ", "does", " ", "not", " ", "require", 
      " ", "rerunning", " ", "the", " ", 
      RowBox[{"ODEs", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"periodicResample", "[", 
      RowBox[{"data_Association", ",", "n_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "tt", ",", "yy", ",", "uu", ",", "t0", ",", "t1", ",", "tNew", ",", 
         "fy", ",", "fu"}], "}"}], ",", 
       RowBox[{
        RowBox[{"tt", "=", 
         RowBox[{"N", "[", 
          RowBox[{"data", "[", "\"\<Time\>\"", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"yy", "=", 
         RowBox[{"N", "[", 
          RowBox[{"data", "[", "\"\<ChlF\>\"", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"uu", "=", 
         RowBox[{"N", "[", 
          RowBox[{"data", "[", "\"\<Light\>\"", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "tt", "]"}], "!=", 
            RowBox[{"Length", "[", "yy", "]"}]}], "||", 
           RowBox[{
            RowBox[{"Length", "[", "tt", "]"}], "!=", 
            RowBox[{"Length", "[", "uu", "]"}]}], "||", 
           RowBox[{
            RowBox[{"Length", "[", "tt", "]"}], "<", "3"}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"t0", "=", 
         RowBox[{"First", "[", "tt", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"t1", "=", 
         RowBox[{"Last", "[", "tt", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fy", "=", 
         RowBox[{"Interpolation", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"tt", ",", "yy"}], "}"}], "]"}], ",", 
           RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fu", "=", 
         RowBox[{"Interpolation", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"tt", ",", "uu"}], "}"}], "]"}], ",", 
           RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tNew", "=", 
         RowBox[{"t0", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"t1", "-", "t0"}], ")"}], " ", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{"n", "-", "1"}]}], "]"}], "/", "n"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Time\>\"", "->", "tNew"}], ",", 
          RowBox[{"\"\<Light\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"fu", "/@", "tNew"}], "]"}]}], ",", 
          RowBox[{"\"\<ChlF\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"fy", "/@", "tNew"}], "]"}]}]}], "|>"}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "V", ".4", " ", "Fundamental", " ", "coefficient", " ", "and", " ", 
       "FRF", " ", "Same", " ", "Fourier", " ", "convention", " ", "as", " ", 
       RowBox[{"runOneT", ":", "FourierParameters"}]}], "->", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "}"}], " ", 
       RowBox[{"Input", ":", 
        RowBox[{
        "two", " ", "complete", " ", "periods", " ", "with", " ", "N", " ", 
         RowBox[{"samples", ".", "The"}], " ", "fundamental", " ", "is", " ", 
         "therefore", " ", "Fourier", " ", "bin", " ", "2"}]}]}]}], ",", 
     RowBox[{"which", " ", "occupies", " ", "position", " ", "3", " ", "in", " ", 
      RowBox[{"Mathematica", "'"}], "s", " ", 
      RowBox[{"list", "."}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fundamentalC1", "[", 
      RowBox[{"y_List", ",", "nPeriods_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", "spectrum"}], "}"}], ",", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "y", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"n", ",", "nPeriods"}], "]"}], "!=", "0"}], "||", 
           RowBox[{"n", "<", 
            RowBox[{"4", " ", "nPeriods"}]}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"spectrum", "=", 
         RowBox[{
          RowBox[{"Fourier", "[", 
           RowBox[{
