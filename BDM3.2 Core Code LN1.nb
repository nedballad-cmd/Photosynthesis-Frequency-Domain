Cell[CellGroupData[{

Cell[TextData[StyleBox["III.3 Execution and convergence monitoring",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.7803921568627451, 0.4235294117647059, 0.1607843137254902]]], "Subsection",
 CellFrame->{{0, 0}, {0.5, 0.5}},
 CellFrameColor->RGBColor[0.6, 0.4, 0.2],
 CellChangeTimes->{{3.9316167181482306`*^9, 3.931616725207141*^9}, 
   3.9316172604007163`*^9, {3.931617329225854*^9, 3.931617331570511*^9}, {
   3.931618560961228*^9, 3.931618561886388*^9}, {3.931758655571293*^9, 
   3.9317586654545097`*^9}, {3.9317587010901165`*^9, 3.931758757425419*^9}, {
   3.931759443826582*^9, 3.9317594539576263`*^9}, {3.931765976850231*^9, 
   3.931765981879921*^9}, 3.931766325094534*^9, {3.931771477482258*^9, 
   3.9317715012478504`*^9}, 3.9317718408597984`*^9, 3.9666257266214294`*^9, {
   3.966625762946089*^9, 3.9666257757482033`*^9}, {3.9666269362883205`*^9, 
   3.9666269365353165`*^9}, {3.9772096545071354`*^9, 
   3.9772096711677074`*^9}, {3.977335464650997*^9, 3.977335471076271*^9}, {
   3.97754633709873*^9, 3.977546403612154*^9}, {3.9775468481231575`*^9, 
   3.9775468584734535`*^9}, {3.9775468989944134`*^9, 
   3.9775469230248737`*^9}, {3.977550373798399*^9, 3.977550377315895*^9}, {
   3.977557181056284*^9, 3.977557184740883*^9}, 3.977557447352001*^9, {
   3.977557592596981*^9, 3.9775575962889442`*^9}, {3.977557733183359*^9, 
   3.9775577565172615`*^9}},
 FontSize->16,
 FontWeight->Bold,ExpressionUUID->"4b49674c-0269-954c-b151-1d51d1b4d146"],

Cell["\<\
In this section, the period-chunked Poincar\[EAcute] integration is executed \
for a given forcing period T, starting from the selected initial condition, \
as a diagnostic and validation sweep of the time-dependent dynamics. Before \
integration, a sanity check is performed on the right-hand sides of the ODE \
system to ensure that all state variables appear only as time-dependent \
functions, preventing accidental use of bare symbols.
The system is then integrated one forcing period at a time using the \
RunByPeriods routine. Convergence is monitored either on the full state \
vector or on chlorophyll fluorescence, as specified by the chosen convergence \
metric. After each period, the system state (or selected observable) sampled \
at a fixed phase of the forcing cycle is compared to previous samples to \
assess convergence toward a periodic attractor.
By default, this section is disabled and skipped during standard notebook \
execution to avoid redundant integrations. When enabled explicitly, execution \
proceeds silently without intermediate console output or file-based logging, \
allowing focused convergence testing and debugging. Integration terminates \
either when convergence criteria are satisfied or when a maximum number of \
forcing periods is reached. Runs that do not converge are explicitly flagged \
and returned as structured failures, rather than aborting the overall workflow.
This section performs no exports and produces no persistent output artifacts; \
its purpose is to support development, verification, and methodological \
checks. Production runs and all result exports are handled downstream in \
Section IV.\
\>", "Text",
 CellChangeTimes->{
  3.977753605957567*^9, {3.9778090047520466`*^9, 3.9778090154527283`*^9}, {
   3.9782300220200405`*^9, 
   3.9782300364449177`*^9}},ExpressionUUID->"95a68ad3-1f48-5345-a5ac-\
98788d27f18e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Optional", ":", 
    RowBox[{
    "clear", " ", "state", " ", "symbols", " ", "only", " ", "if", " ", "you",
      " ", "really", " ", "need", " ", "to", " ", "wipe", " ", "prior", " ", 
     "defs"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "PQ", ",", "PIox", ",", "Zea", ",", "PsbS", ",", "HL", ",", "ATP"}], 
     "]"}], ";"}], "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{"(*", 
   RowBox[{"Sanity", " ", 
    RowBox[{"check", ":", 
     RowBox[{
     "no", " ", "bare", " ", "state", " ", "symbols", " ", "should", " ", 
      "appear", " ", "in", " ", "RHS", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"use", " ", 
         RowBox[{"PQ", "[", "t", "]"}]}], ",", 
        RowBox[{"etc", "."}]}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "III", ".3", " ", "Execution", " ", "and", " ", "convergence", " ", 
    "monitoring", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"inline", " ", "per"}], "-", 
      RowBox[{"T", " ", "run"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"runIII3Sweep", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "set", " ", "True", " ", "only", " ", "when", " ", "you", " ", 
      "explicitly", " ", "want", " ", "to", " ", "run", " ", "III", ".3"}], ",", 
     RowBox[{
     "including", " ", "the", " ", "additional", " ", "integration"}]}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"TrueQ", "@", "runIII3Sweep"}], ",", 
      RowBox[{"results", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Tval", "=", 
              RowBox[{"N", "@", "T"}]}], ",", "ODEs", ",", "bad", ",", "out", 
             ",", "kConv"}], "}"}], ",", 
           RowBox[{"(*", 
            RowBox[{
            "Build", " ", "ODEs", " ", "for", " ", "this", " ", "period"}], 
            "*)"}], 
           RowBox[{
            RowBox[{"ODEs", "=", 
             RowBox[{"Flatten", "@", 
              RowBox[{"MakeODEs", "[", "Tval", "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"MatchQ", "[", 
                RowBox[{"ODEs", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"(", "_Equal", ")"}], ".."}], "}"}]}], "]"}]}], ",", 
              RowBox[{"Return", "[", 
               RowBox[{"fail", "[", 
                RowBox[{"Tval", ",", 
                 RowBox[{"<|", 
                  
                  RowBox[{"\"\<Message\>\"", 
                   "->", "\"\<ODEsNotEquationList\>\""}], "|>"}]}], "]"}], 
               "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Sanity", " ", 
              RowBox[{"check", ":", 
               RowBox[{
               "no", " ", "bare", " ", "state", " ", "symbols", " ", "in", " ",
                 "RHS", " ", 
                RowBox[{"(", 
                 RowBox[{"PQ", " ", "vs", " ", 
                  RowBox[{"PQ", "[", "t", "]"}]}], ")"}]}]}]}], "*)"}], 
            RowBox[{"bad", "=", 
             RowBox[{"DeleteDuplicates", "@", 
              RowBox[{"Cases", "[", 
               RowBox[{
                RowBox[{"ODEs", "/.", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"lhs_", "==", "rhs_"}], ":>", "rhs"}], ")"}]}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"s", ":", 
                   RowBox[{"(", 
                    RowBox[{
                    "PQ", "|", "PIox", "|", "Zea", "|", "PsbS", "|", "HL", "|",
                     "ATP"}], ")"}]}], "/;", 
                  RowBox[{"FreeQ", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"s", "[", "_", "]"}]}], "]"}]}], "&"}], ",", 
                "Infinity"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"bad", "=!=", 
               RowBox[{"{", "}"}]}], ",", 
              RowBox[{"Return", "[", 
               RowBox[{"fail", "[", 
                RowBox[{"Tval", ",", 
                 RowBox[{"<|", 
                  RowBox[{
                   
                   RowBox[{"\"\<Message\>\"", 
                    "->", "\"\<BareStateVarsInRHS\>\""}], ",", 
                   RowBox[{"\"\<BadSymbols\>\"", "->", "bad"}]}], "|>"}]}], 
                "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Run", " ", "period"}], "-", 
              RowBox[{"chunked", " ", "integration"}]}], "*)"}], 
            RowBox[{"out", "=", 
             RowBox[{"RunByPeriodsIC", "[", 
              RowBox[{"ODEs", ",", "initCond", ",", "Tval", ",", 
               RowBox[{"\"\<MaxPeriods\>\"", "->", "MaxPeriods"}], ",", 
               RowBox[{"\"\<ConvergenceMetric\>\"", "->", "convMetric"}], ",", 
               RowBox[{"\"\<PrintEvery\>\"", "->", "0"}], ",", 
               RowBox[{"\"\<KeepChunkSols\>\"", "->", "False"}], ",", 
               RowBox[{"\"\<LogDir\>\"", "->", "None"}], ",", 
               RowBox[{"\"\<LogFile\>\"", "->", "None"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"out", "===", "$Failed"}], ",", 
              RowBox[{"Return", "@", 
               RowBox[{"fail", "[", 
                RowBox[{"Tval", ",", 
                 RowBox[{"<|", 
                  
                  RowBox[{"\"\<Message\>\"", 
                   "->", "\"\<RunByPeriodsFailed\>\""}], "|>"}]}], "]"}]}]}], 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"AssociationQ", "[", "out", "]"}]}], ",", 
              RowBox[{"Return", "@", 
               RowBox[{"fail", "[", 
                RowBox[{"Tval", ",", 
                 RowBox[{"<|", 
                  RowBox[{
                   
                   RowBox[{"\"\<Message\>\"", 
                    "->", "\"\<RunByPeriodsReturnedNonAssociation\>\""}], ",", 
                   RowBox[{"\"\<OutHead\>\"", "->", 
                    RowBox[{"Head", "[", "out", "]"}]}], ",", 
                   RowBox[{"\"\<OutValue\>\"", "->", 
                    RowBox[{"InputForm", "[", "out", "]"}]}]}], "|>"}]}], 
                "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"TrueQ", "@", 
                RowBox[{"Lookup", "[", 
                 RowBox[{"out", ",", "\"\<Success\>\"", ",", "True"}], 
                 "]"}]}]}], ",", 
              RowBox[{"Return", "@", 
               RowBox[{"fail", "[", 
                RowBox[{"Tval", ",", 
                 RowBox[{"<|", 
                  RowBox[{
                   
                   RowBox[{"\"\<Message\>\"", 
                    "->", "\"\<RunByPeriodsReportedFailure\>\""}], ",", 
                   RowBox[{"\"\<Detail\>\"", "->", "out"}]}], "|>"}]}], 
                "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"kConv", "=", 
             RowBox[{"Lookup", "[", 
              RowBox[{"out", ",", "\"\<ConvergedAtPeriod\>\"", ",", 
               RowBox[{"Missing", "[", "\"\<NotConverged\>\"", "]"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"IntegerQ", "[", "kConv", "]"}]}], ",", 
              RowBox[{"Return", "@", 
               RowBox[{"fail", "[", 
                RowBox[{"Tval", ",", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<Message\>\"", "->", "\"\<NotConverged\>\""}], 
                   ",", 
                   RowBox[{"\"\<ConvergedAtPeriod\>\"", "->", "kConv"}]}], 
                  "|>"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Success", " ", "payload"}], "*)"}], 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<T\>\"", "->", "Tval"}], ",", 
              RowBox[{"\"\<Success\>\"", "->", "True"}], ",", 
              RowBox[{"\"\<ConvergedAtPeriod\>\"", "->", 
               RowBox[{"out", "[", "\"\<ConvergedAtPeriod\>\"", "]"}]}], ",", 
              RowBox[{"\"\<ConvergenceMetric\>\"", "->", 
               RowBox[{"out", "[", "\"\<ConvergenceMetric\>\"", "]"}]}], ",", 
              RowBox[{"\"\<LogPath\>\"", "->", 
               RowBox[{"out", "[", "\"\<LogPath\>\"", "]"}]}]}], "|>"}]}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"T", ",", "Tlist"}], "}"}]}], "]"}]}], ",", 
      RowBox[{
      "Print", "[", "\"\<III.3 sweep skipped (runIII3Sweep=False).\>\"", 
       "]"}]}], "]"}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
