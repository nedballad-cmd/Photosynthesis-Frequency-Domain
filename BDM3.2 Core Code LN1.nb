Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Light", "-", 
    RowBox[{
    "acclimated", " ", "initial", " ", "state", " ", "from", " ", "FindRoot", 
     " ", "solution"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"stateLight", "=", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<PQ\>\"", "->", 
        RowBox[{"Chop", "@", 
         RowBox[{"Re", "@", 
          RowBox[{"N", "[", 
           RowBox[{"PQSS", "/.", " ", "steadyStateSolution"}], "]"}]}]}]}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"\"\<PIox\>\"", "->", 
        RowBox[{"Chop", "@", 
         RowBox[{"Re", "@", 
          RowBox[{"N", "[", 
           RowBox[{"PIoxSS", "/.", " ", "steadyStateSolution"}], "]"}]}]}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<Zea\>\"", "->", 
        RowBox[{"Chop", "@", 
         RowBox[{"Re", "@", 
          RowBox[{"N", "[", 
           RowBox[{"ZeaSS", "/.", " ", "steadyStateSolution"}], "]"}]}]}]}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"\"\<PsbS\>\"", "->", 
        RowBox[{"Chop", "@", 
         RowBox[{"Re", "@", 
          RowBox[{"N", "[", 
           RowBox[{"PsbSSS", "/.", " ", "steadyStateSolution"}], "]"}]}]}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<HL\>\"", "->", 
        RowBox[{"Chop", "@", 
         RowBox[{"Re", "@", 
          RowBox[{"N", "[", 
           RowBox[{"HLSS", "/.", " ", "steadyStateSolution"}], "]"}]}]}]}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"\"\<ATP\>\"", "->", 
        RowBox[{"Chop", "@", 
         RowBox[{"Re", "@", 
          RowBox[{"N", "[", 
           RowBox[{"ATPSS", "/.", " ", "steadyStateSolution"}], "]"}]}]}]}]}],
       "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Dark", " ", "reference", " ", "state", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"used", " ", "as", " ", "initial", " ", "condition"}], ";", 
       RowBox[{"not", " ", "obtained", " ", "from", " ", "FindRoot"}]}], 
      ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"stateDark", "=", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<PQ\>\"", "->", "PQtot"}], ",", 
