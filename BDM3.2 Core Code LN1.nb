                 RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"FrameLabel", "->", 
                  RowBox[{"{", 
                   RowBox[{"\"\<T_used (s)\>\"", ",", "\"\<|G1|\>\""}], 
                   "}"}]}], ",", "\[IndentingNewLine]", 
                 RowBox[{"PlotRange", "->", "All"}], ",", 
                 RowBox[{"ImageSize", "->", "Large"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"PlotLabel", "->", 
                  RowBox[{"Row", "[", 
                   RowBox[{"{", 
                    RowBox[{"sig", ",", "\"\<  |G1|(T)\>\""}], "}"}], 
                   "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"pPh", "=", 
               RowBox[{"ListLogLinearPlot", "[", 
                RowBox[{"datPh", ",", 
                 RowBox[{"Joined", "->", "True"}], ",", 
                 RowBox[{"Frame", "->", "True"}], ",", 
                 RowBox[{"FrameLabel", "->", 
                  RowBox[{"{", 
                   
                   RowBox[{"\"\<T_used (s)\>\"", 
                    ",", "\"\<phase1 (deg)\>\""}], "}"}]}], ",", 
                 RowBox[{"PlotRange", "->", "All"}], ",", 
                 RowBox[{"ImageSize", "->", "Large"}], ",", 
                 RowBox[{"PlotLabel", "->", 
                  RowBox[{"Row", "[", 
                   RowBox[{"{", 
                    RowBox[{"sig", ",", "\"\<  phase1(T)\>\""}], "}"}], 
                   "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"out", "=", 
