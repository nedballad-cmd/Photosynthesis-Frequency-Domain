Cell["U.a. Generic filesystem helpers", "Subsection",
 CellChangeTimes->{{3.9316172253028307`*^9, 3.9316172315405197`*^9}, {
   3.9316173221999707`*^9, 3.931617323622217*^9}, {3.9316264716698666`*^9, 
   3.9316264755689526`*^9}, {3.9317588730636997`*^9, 
   3.9317588821065083`*^9}, {3.93175948794602*^9, 3.931759492165785*^9}, {
   3.9317661339649715`*^9, 3.931766143729948*^9}, {3.931766252982313*^9, 
   3.9317662636712284`*^9}, 3.9773357444639015`*^9, 3.977363408861023*^9, {
   3.9774997266929417`*^9, 3.9774997653966846`*^9}, 3.977549630297289*^9, {
