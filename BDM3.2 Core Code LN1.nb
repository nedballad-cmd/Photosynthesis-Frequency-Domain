             RowBox[{"ref", "[", "\"\<PhaseDeg\>\"", "]"}]}], "}"}]}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"Tval", ",", "Tlist"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"npp", ",", "samplesPerPeriod"}], "}"}]}], "]"}], ",", 
       "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
