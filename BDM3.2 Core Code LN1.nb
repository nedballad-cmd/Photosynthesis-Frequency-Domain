       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Zea", "[", "0", "]"}], "==", "0"}], ",", 
       RowBox[{"(*", 
        RowBox[{"no", " ", "Zea", " ", "quenching"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PsbS", "[", "0", "]"}], "==", "0"}], ",", 
       RowBox[{"(*", 
        RowBox[{"no", " ", "PsbS", " ", "quenching"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HL", "[", "0", "]"}], "==", "Hstroma"}], ",", 
       RowBox[{"(*", 
        RowBox[{"no", " ", "pH", " ", "gradient"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ATP", "[", "0", "]"}], "==", "0"}]}], "\[IndentingNewLine]", 
      "}"}]}], ";"}], "\n", "\n", 
